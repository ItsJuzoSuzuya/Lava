// A program in the subset the parser written in Lava understands
let n = 10;
mut i = 0;
mut sum = 0;
while i < n {
  if i % 2 == 1 {
    sum = sum + i;
  }
  i = i + 1;
}
print(sum);

mut factorial = 1;
mut k = 1;
while k <= 5 {
  factorial = factorial * k;
  k = k + 1;
}
print(factorial);
print(!(factorial > 100) || factorial == 120);
print(-(2 + 3) * 4);
