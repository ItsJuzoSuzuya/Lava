import std::path::{Path};
import std::vector::{Vector};

// --- HashMaps ---
//
// A draft moved here from the prelude, as it was there. It doesn't compile
// yet, so it's commented out until it's finished:

pub trait Hash {
  pub func hash(&self) -> int32;
}

pub class Bucket<T> {
  pairs: Vector<(int32, T)>;
}

pub class HashMap<Key: Hash, Value> {
  buckets: Bucket<Value>[16] = Bucket[16];

  pub func set(key: Key, value: Value) {
    let hash: int32 = key.hash();

  }
}

impl Hash for String {
  pub func hash(&self) -> int32 {
    return 20;
  }
}

impl Hash for Path {
  pub func hash(&self) -> int32 {
    return 10;
  }
}
