import codegen_ctx;
import std::vector::{Vector};
import modules;
import parser;
import statement;
import std::result::{Result};
import std::process;
import std::process::{run};
import llvm;
import std::option::{Option};
import std::path::{Path};
import sema;

pub enum CompileError {
  Parse => String,
  Semantic => String,
  TargetTripleInvalid => TargetTriple,
  CompilationFailure => String,
  LinkingFailure => String,

  pub func message(&self) -> String {
    match self {
      CompileError::Parse(message) => "[Parser Error]: " + message
      CompileError::Semantic(message) => "[Semantic Error]: " + message
      CompileError::TargetTripleInvalid(triple) => "Couldn't build Target from Triple " + triple.arch
      CompileError::CompilationFailure(message) => "An error occured while compiling: " + message
      CompileError::LinkingFailure(message) => "An error occured while linking: " + message

    }
  }
}

pub class Program {
  pub context: CodegenContext;

  pub func build(&self, graph: &ModuleGraph) -> Result<Path, Vector<CompileError>> {
    mut errors = Vector<CompileError>();

    self.context.build_entry();

    mut parse_errs = Vector<ParseError>();
    mut asts = Vector<Vector<Statement>>();
    for module in graph.modules { 
       let stmts = Parser::from_source(module.source, &parse_errs).parse();
       asts.push(stmts);
    }

    if !parse_errs.is_empty() {
      for err in parse_errs {
        errors.push(CompileError::Parse(err.message()));
      }
    }

    mut sema_errs = Vector<SemanticError>();
    mut sema = Sema(&sema_errs);
    for module in asts {
      sema.check(module);
    }

    if !sema_errs.is_empty() 
      for err in sema_errs {
        errors.push(CompileError::Semantic(err.message()));
      }

    if !errors.is_empty() 
     return Err(errors);

    for module in asts {
      for stmt in module {
        stmt.codegen(self.context);
      }
    }

    if !self.context.builder.get_insert_block().has_terminator() {
      let zero = self.context.context.i32_type().const_int(0, false);
      self.context.builder.build_return(Some(zero));
    }

    mut verify_error: Option<String> = None;
    if self.context.module.verify(&verify_error) != 0 && verify_error is Some(err) {
      errors.push(CompileError::CompilationFailure(err));
      return Err(errors);
    }

    let triple = TargetTriple();
    let target = Target::from_triple(triple);
    self.context.module.set_target(triple);

    if target is Some(t) {
      let machine = TargetMachine::create(t, triple);
      let layout = machine.new_layout();
      self.context.module.set_layout(layout);

      let object = Path("build/main.o");
      let err = machine.compile(self.context.module, object);
      if err is Some(e) {
        errors.push(CompileError::CompilationFailure(e));
        return Err(errors);
      }

      match self.link(object, Path("build/main")) {
        Ok(exec) => return exec
        Err(e) => {
          errors.push(CompileError::LinkingFailure(e));
          return Err(errors);
        }
      }
    }

    errors.push(CompileError::TargetTripleInvalid(triple));
    return Err(errors);
  }

  // Links the object file `object` into the executable `executable`
  func link(&self, object: &Path, executable: &Path) -> Result<Path, String> {
    let command = "cc " + object.to_string() + " -o " + executable.to_string();
    return match process::run(command) {
      Ok(code) => code.is_success() ? Ok(executable.clone()) : Err("linking failed: " + command),
      Err(error) => Err("couldn't run cc: " + error),
    };
  }
}

