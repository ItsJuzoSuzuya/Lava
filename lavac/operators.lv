import token;
import type;
import std::option::{Option};
import std::string::{Print};

pub enum BinaryOp {
  Add, Sub, Mul, Div, Rem,
  Eq, NotEq, Lt, LtEq, Gt, GtEq;

  pub func from_token(kind: TokenKind) -> BinaryOp {
    match kind {
      TokenKind::Plus => BinaryOp::Add,
      TokenKind::Minus => BinaryOp::Sub,
      TokenKind::Multiply => BinaryOp::Mul,
      TokenKind::Divide => BinaryOp::Div,
      TokenKind::Percent => BinaryOp::Rem,
      TokenKind::EqEq => BinaryOp::Eq,
      TokenKind::NotEq => BinaryOp::NotEq,
      TokenKind::Lt => BinaryOp::Lt,
      TokenKind::LtEq => BinaryOp::LtEq,
      TokenKind::Gt => BinaryOp::Gt,
      TokenKind::GtEq => BinaryOp::GtEq,

      kind => panic("Provided token cant be used as an unary operator: " + kind.to_string())
    }
  }

  // The type `lhs op rhs` gives, `None` if the operator doesn't work on these types
  pub func result_type(&self, lhs: Type, rhs: Type) -> Option<Type> {
    match self {
      // arithmetic: two numbers give a number
      BinaryOp::Add | BinaryOp::Sub | BinaryOp::Mul | BinaryOp::Div | BinaryOp::Rem =>
        lhs == Type::Int32 && rhs == Type::Int32 ? Some(Type::Int32) : None,

      // ordering: two numbers give a bool
      BinaryOp::Lt | BinaryOp::LtEq | BinaryOp::Gt | BinaryOp::GtEq =>
        lhs == Type::Int32 && rhs == Type::Int32 ? Some(Type::Boolean) : None,

      // equality: any two values of the same type give a bool
      BinaryOp::Eq | BinaryOp::NotEq =>
        lhs == rhs ? Some(Type::Boolean) : None,
    }
  }
}

impl Print for BinaryOp {
  pub func to_string(&self) -> String {
    match self {
      BinaryOp::Add => "+"
      BinaryOp::Sub => "-"
      BinaryOp::Mul => "*"
      BinaryOp::Div => "/"
      BinaryOp::Rem => "%"
      BinaryOp::Eq  => "=="
      BinaryOp::NotEq => "!="
      BinaryOp::Lt => "<"
      BinaryOp::LtEq => "<="
      BinaryOp::Gt => ">"
      BinaryOp::GtEq => ">="
      
    }
  }
}

pub enum UnaryOp {
  Negation, Bang

  pub func from_token(kind: TokenKind) -> UnaryOp {
    match kind {
      TokenKind::Minus => UnaryOp::Negation,
      TokenKind::Bang => UnaryOp::Bang,

      kind => panic("Provided token cant be used as an unary operator: " + kind.to_string())
    }
  }
}

impl Print for UnaryOp {
  pub func to_string(&self) -> String {
    match self {
      UnaryOp::Negation => "-"
      UnaryOp::Bang => "!"
    }
  }
}
