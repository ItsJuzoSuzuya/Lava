import span;
import expression;
import type;
import codegen;
import codegen_ctx;
import llvm;
import std::option::{Option};
import std::math::{exp};
import std::vector::{Vector};

pub class Statement {
  pub kind: StmtKind;
  pub span: Span;
}

impl Codegen for Statement {
  pub func codegen(self, mut ctx: &CodegenContext) -> Option<LLVMValueRef> {
    match self.kind {
      StmtKind::Assignment(var, val) => {
        let v = val.codegen(ctx) ?? return None;
        ctx.store_variable(var, v);
        return None;
      }
      StmtKind::Instantiation(name, _, expr, is_mut) => {
        let value = expr.codegen(ctx) ?? return None;
        ctx.declare_variable(name, value, expr.ty.to_llvm(ctx), is_mut);
        return None;
      }
      StmtKind::Print(expr) => {
        ctx.load_print_fn();
        let value = expr.codegen(ctx) ?? return None;
        mut args = Vector<LLVMValueRef>();
        args.push(ctx.builder.build_const_str_ptr((expr.ty.formatter() ?? return None) + "\n", "format"));
        expr.print_args(ctx, value, expr.ty, &args);

        return ctx.call_fn("printf", &args);
      }
      StmtKind::Return(expr) => return ctx.builder.build_return(expr.codegen(ctx)),
      StmtKind::Value(expr) => return expr.codegen(ctx),
      StmtKind::Expression(expr) => return expr.codegen(ctx)
    }

    return None;
  }
}

pub enum StmtKind {
  Instantiation => { 
    name: String,
    ty: Option<TypeAnnotation>,
    value: Expression,
    is_mut: bool
  }

  /// `x = value;`, a new value for an existing variable
  Assignment => {
    name: String,
    value: Expression
  }

  Print => Expression,
  Return => Expression,
  Expression => Expression,
  Value => Expression
}

