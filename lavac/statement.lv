import span;
import expression;
import type;
import codegen;
import codegen_ctx;
import llvm;
import std::option::{Option};
import std::math::{exp};

pub class Statement {
  pub kind: StmtKind;
  span: Span;
}

impl Codegen for Statement {
  pub func codegen(self, mut ctx: &CodegenContext) -> Option<LLVMValueRef> {
    match self.kind {
      StmtKind::Let(name, _, expr) => {
        let value = expr.codegen(ctx) ?? return None;
        ctx.declare_variable(name, value, expr.ty.to_llvm(ctx));
        return None;
      }

      StmtKind::Print(expr) => {
        ctx.load_print_fn();
        let f = expr.llvm_string(ctx) ?? return None;
        let format = ctx.builder.build_const_str_ptr(expr.ty.formatter() ?? return None, "format");

        return ctx.call_fn("printf", &[format, f]);
      }
      StmtKind::Return(expr) => return ctx.builder.build_return(expr.codegen(ctx)),
      StmtKind::Value(expr) => return expr.codegen(ctx),
      StmtKind::Expression(expr) => return expr.codegen(ctx)
    }

    return None;
  }
}

pub enum StmtKind {
  Let => { 
    name: String,
    ty: Option<type::Type>,
    value: Expression
  }

  Print => Expression,
  Return => Expression,
  Expression => Expression,
  Value => Expression
}
