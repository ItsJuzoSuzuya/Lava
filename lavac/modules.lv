import std::vector::{Vector};
import span;
import std::path::{Path};
import std::option::{Option};
import std::string;
import std::hashmap;
import std::hashmap::{HashMap};
import lexer;
import program;
import parser;
import std::fs;

/// A module imported by another one, like `import math;` or
/// `import std::fs::{read};` at `span`.
pub class Import {
  /// Name of the imported module, `math` or `std::fs`.
  pub name: String;
}

/// A source file of the program.
pub class Module {
  pub imports: Vector<Import>;
  /// Canonical path of the file.
  pub path: Path;
  pub source: String;

  /// Module name, the file name without `.lv` (`math` for `math.lv`), or
  /// like `std::fs` for a module of the standard library.
  pub full_name: String = path.file_stem();

  /// The name of the standard library module this is, `fs` for `std::fs`.
  pub func strip_std(&self) -> Option<String> {
      return self.full_name.strip_prefix("std::");
  }
}

/// All modules reachable from a root source file.
///
/// Built by [`ModuleGraph::new`], which loads the root module and then
/// recursively loads every module it imports. An import `foo` resolves to the
/// file `foo.lv` next to the importing file.
///
/// Each file is loaded only once, even if several modules import it, and
/// import cycles are allowed. [`ModuleGraph::modules`] lists imports before
/// the modules importing them.
pub class ModuleGraph {
  pub modules: Vector<Module> = Vector();
  pub module_errors: Vector<ParseError> = Vector();

  overlay: HashMap<Path,String> = HashMap();

  Constructor(root_path: Path) {
    mut modules = Vector<Module>();
    mut module_errors = Vector<ParseError>();
    let source = match fs::read(root_path) {
      Ok(txt) => txt
      Err(err) => panic("couldnt read root path: " + err)
    };
    let imports = Parser::from_source(source, &module_errors).parse_imports();
    self.modules.push(Module(imports, root_path, source));
  }
}
