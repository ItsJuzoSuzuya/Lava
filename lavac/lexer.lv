import token;
import std::string::{is_whitespace, is_alpha, is_alphanumeric, is_digit};
import span;
import std::result::{Result};
import std::option::{Option};
import diagnostic;

/// Turns source code into [`Token`]s, one at a time.
///
/// Tracks the current line and column, so every token comes with the [`Span`]
/// it was read from.
pub class Lexer {
  source: String;

  position: uint64 = 0;
  line: uint32 = 1;
  col: uint32 = 1;

  pub func next_token(mut &self) -> Result<Token, LexError> {
    self.skip_blank();
    let line = self.line;
    let col = self.col;
    if self.at_end() {
      let span = Span(line, col, 0);
      let token = Token(TokenKind::EOF, span);
      return Ok(token);
    }

    let current = self.current();
    let start_point = self.position;

    if self.symbol() is Some(sym, len) {
      self.advance(len);
      let span = Span(line, col, len);
      return Token(sym, span);
    }

    if is_alpha(current) || current == '_' {
      while !self.at_end() && (is_alphanumeric(self.current()) || self.current() == '_') {
        self.advance();
      }
      let word = self.source.slice(start_point, self.position);
      let kind = TokenKind::from_string(word);
      let span = Span(line, col, word.len() as uint32);
      return Ok(Token(kind, span));
    }

    if is_digit(current) {
      while !self.at_end() && is_digit(self.current()) {
        self.advance();
      } 

      // '.' signals floating point number
      if self.current() == '.' {
        self.advance();
        while !self.at_end() && is_digit(self.current()) {
          self.advance();
        } 
        
        let number = self.source.slice(start_point, self.position);
        let span = Span(line, col, number.len() as uint32);
        match number.try_as<float64>() {
          Some(f64) => return Ok(Token(TokenKind::FloatLiteral(f64), span))
          None => return Err(LexError::FloatLiteralToBig(Token(TokenKind::Err(number), span)))
        }
      }
      
      // If not float then int
      let number = self.source.slice(start_point, self.position);
      let span = Span(line, col, number.len() as uint32);
      match number.try_as<int64>() {
        Some(i64) => return Token(TokenKind::IntLiteral(i64), span)
        None => return Err(LexError::IntLiteralToBig(Token(TokenKind::Err(number), span)))
      }
    }
    
    self.advance();
    let token = self.source.slice(start_point, self.position);
    let span = Span(line, col, token.len() as uint32);
    return Err(LexError::TokenNotImplemented(Token(TokenKind::Err(token), span)));
  }

  pub func peek(mut &self) -> Result<Token, LexError> {
    self.skip_blank();
    if self.at_end() {
      let span = Span(self.line, self.col, 0);
      let token = Token(TokenKind::EOF, span);
      return Ok(token);
    }

    let line = self.line;
    let col = self.col;
    let current = self.current();
    let start_point = self.position;

    if self.symbol() is Some(sym, len) {
      let span = Span(line, col, len);

      self.position = start_point;
      self.line = line;
      self.col = col;
      return Token(sym, span);
    }

    if is_alpha(current) || current == '_' {
      while !self.at_end() && (is_alphanumeric(self.current()) || self.current() == '_') {
        self.advance();
      }
      let word = self.source.slice(start_point, self.position);
      let kind = TokenKind::from_string(word);
      let span = Span(line, col, word.len() as uint32);

      self.position = start_point;
      self.line = line;
      self.col = col;
      return Ok(Token(kind, span));
    }

    if is_digit(current) {
      while !self.at_end() && is_digit(self.current()) {
        self.advance();
      } 

      // '.' signals floating point number
      if self.current() == '.' {
        self.advance();
        while !self.at_end() && is_digit(self.current()) {
          self.advance();
        } 
        
        let number = self.source.slice(start_point, self.position);
        let span = Span(line, col, number.len() as uint32);

        self.position = start_point;
        self.line = line;
        self.col = col;
        match number.try_as<float64>() {
          Some(f64) => return Ok(Token(TokenKind::FloatLiteral(f64), span))
          None => return Err(LexError::FloatLiteralToBig(Token(TokenKind::Err(number), span)))
        }
      }
      
      // If not float then int
      let number = self.source.slice(start_point, self.position);
      let span = Span(line, col, number.len() as uint32);

      self.position = start_point;
      self.line = line;
      self.col = col;
      match number.try_as<int64>() {
        Some(i64) => return Ok(Token(TokenKind::IntLiteral(i64), span))
        None => return Err(LexError::IntLiteralToBig(Token(TokenKind::Err(number), span)))
      }
    }

    let token = self.source.slice(start_point, self.position);
    let span = Span(line, col, token.len() as uint32);
    self.position = start_point;
    self.line = line;
    self.col = col;

    return Err(LexError::TokenNotImplemented(Token(TokenKind::Err(token), span)));
  }

  /// Skip whitespaces and comments
  func skip_blank(mut &self) {
    while !self.at_end() {
      if is_whitespace(self.current()) 
        self.advance();
        
      else if self.current() == '/' && self.following() == '/' {
        while !self.at_end() && self.current() != '\n' {
          self.advance();
        }
      } 
      else break;
    }
  }

  func symbol(&self) -> Option<(TokenKind, uint32)> {
    let next = self.position + 1 < self.source.len() ? self.following() : ' ';
    let double = match (self.current(), next) {
      ('&', '&') => Some(TokenKind::AndAnd),
      ('-', '>') => Some(TokenKind::Arrow),
      (':', ':') => Some(TokenKind::ColonColon),
      ('=', '=') => Some(TokenKind::EqEq),
      ('!', '=') => Some(TokenKind::NotEq),
      ('=', '>') => Some(TokenKind::ThickArrow),
      // ... the rest of your two-char symbols
      _ => None,
    };
    if double is Some(kind) return Some(kind, 2 as uint32);

    let single = match self.current() {
      '[' => TokenKind::LBracket,
      ']' => TokenKind::RBracket,
      '{' => TokenKind::LBrace,
      '}' => TokenKind::RBrace,
      '(' => TokenKind::LParen,
      ')' => TokenKind::RParen,
      ';' => TokenKind::Semicolon,
      '=' => TokenKind::Assign,
      '+' => TokenKind::Plus,
      '-' => TokenKind::Minus,
      '*' => TokenKind::Multiply,
      '/' => TokenKind::Divide,
      '%' => TokenKind::Percent,
      '<' => TokenKind::Lt,
      '>' => TokenKind::Gt,
      '!' => TokenKind::Bang,
      ',' => TokenKind::Comma,
      '.' => TokenKind::Dot,
      ':' => TokenKind::Colon,
      _ => return None,
    };
    return Some(single, 1 as uint32);
  }

  func advance(mut &self, len: uint32 = 1) {
    mut i: uint32 = 0;
    while i < len {
      if self.current() == '\n' {
        self.position += 1;
        self.line += 1;
        self.col = 1;
      } else {
        self.position += 1;
        self.col += 1;
      }

      i +=1;
    }
  }

  func current(&self) -> char {
    return self.source[self.position];
  }

  func following(&self) -> char {
    return self.source[self.position + 1];
  }

  func at_end(&self) -> bool {
    self.position >= self.source.len()
  }
}

