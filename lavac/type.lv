import std::option::{Option};
import llvm;
import codegen_ctx;
import std::string::{Print};
import expression;

pub enum TypeAnnotation {
  Array => { element: Unique<TypeAnnotation>, length: Expression }
  Boolean,
  Int32,
  Named => String,
}

pub enum Type {
  Array => {
    type: Shared<Type>,
    length: uint32
  },
  Boolean,
  Class => String,
  Error,
  Int32,
  Void,

  pub func formatter(&self) -> Option<String> {
    match self {
      Type::Array(elem, length) => {
        let one = elem.formatter() ?? return None;
        mut format = "[";
        format += (one + ", ").repeat(length-1);
        format += one + "]";
        return format;
      }
      Type::Boolean => "%s"
      Type::Int32 => "%d"
      _ => return None
    }
  }

  pub func to_llvm(&self, ctx: &CodegenContext) -> llvm::Type {
    match self {
      Type::Array(type, length) => ctx.context.array_type(type.to_llvm(ctx), length),
      Type::Boolean => ctx.context.bool_type(),   // i1
      Type::Class(name) => panic("classes aren't supported in codegen yet: " + name),
      Type::Error => panic("No llvm type for 'Type::Error'")
      Type::Int32 => ctx.context.i32_type(),
      Type::Void => ctx.context.void_type(),
    }
  }
}

impl Print for Type {
  pub func to_string(&self) -> String {
    match self {
      Type::Array(type, length) => type.to_string() + "[" + length.to_string() + "]"
      Type::Boolean => "bool"
      Type::Class(name) => name
      Type::Error => "Error"
      Type::Int32 => "int32"
      Type::Void => "void"
    }
  }
}
