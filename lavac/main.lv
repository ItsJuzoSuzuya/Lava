import std::env::{args};
import std::fs::{read, write, create_dir_all};
import std::path::{Path};
import std::process::{ExitCode};
import std::option::{Option};
import std::result::{Result};
import std::vector::{Vector};
import llvm;
import modules;
import program;
import codegen_ctx;

func main() -> int32 {
  CodegenContext::initialize_native_target();

  let args = args().collect();
  match args[1] {
    "run" => {
      let main = main_file(args.at(2) ?? "main.lv");
      run(main);
    },
    "build" => build_command(&args)
  }

  ExitCode::Success.to_int()
}

func main_file(file: &String) -> Path {
  let path = Path(file.clone());
  
  if path.is_dir() 
    return path.join("main.lv");

  if !path.is_file() 
    panic("Path is not a file!");

  path
}


/// `lava build [file] [-o path]`
func build_command(args: &Vector<String>) -> Result<ExitCode, String> {
    let (files, output) = match args {
        [..rest, "-o", output] => (rest.clone(), Some(Path(output.clone()))),
        rest => (rest.clone(), None),
    };

    let file = files.len() > 2 ? files[2].clone() : "main.lv";
    let main = main_file(file);

    let executable = build(&main, output);
    Ok(ExitCode::Success)
}

func build(main: &Path, output: Option<Path>) -> Result<Path,Vector<CompileError>> {
  let dir = main.parent();
  let name = main.file_name();
  let build_dir = dir.join("build");

  if create_dir_all(&build_dir) is Err(err) 
    panic("filesystem error: couldnt create build directory as " + build_dir.to_string() + " \n" + err);

  let object = build_dir.join(name + ".0");
  let executable = output ?? build_dir.join(name);
  let context = Context();

  let program = Program(CodegenContext(&context));
  mut graph = ModuleGraph(main);
  if program.build(graph) is Err(err)
    return Err(err);

  return executable;
}

func run(file: Path) {
  let build = build(file, None);
  match build {
    Ok(executable) => run(executable)
    Err(errors) => print_errors(errors)
  };
}

func print_errors(errors: &Vector<CompileError>) {
  for err in errors {
    panic("[Compile Error] " + err.message());
  }
}
