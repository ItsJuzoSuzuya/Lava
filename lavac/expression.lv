import std::vector::{Vector};
import statement;
import std::option::{Option};
import span;
import codegen;
import codegen_ctx;
import llvm;
import type;
import std::math::{min, exp};
import std::result::{Result};
import token;
import operators;

pub class Expression {
  pub kind: ExprKind;
  pub span: Span;
  pub ty: type::Type;

  pub func codegen_value(&self, ctx: &CodegenContext) -> Option<LLVMValueRef> {
    match self.kind {
      ExprKind::Boolean(val) => {
        let int = val ? 1 : 0;
        return ctx.context.bool_type().const_int(int as uint64, false);
      },

      ExprKind::IntLiteral(val) => {
        return ctx.context.i32_type().const_int(val as uint64, false);
      },

      ExprKind::BinaryExpr(lhs, op, rhs) => {
        let l = lhs.codegen(ctx) ?? return None;
        let r = rhs.codegen(ctx) ?? return None;
        return match op {
          BinaryOp::Add   => ctx.builder.build_add(l, r, "add"),
          BinaryOp::Sub   => ctx.builder.build_sub(l, r, "sub"),
          BinaryOp::Mul   => ctx.builder.build_mul(l, r, "mul"),
          BinaryOp::Div   => ctx.builder.build_div(l, r, "div"),
          BinaryOp::Rem   => ctx.builder.build_mod(l, r, "mod"),
          BinaryOp::Lt    => ctx.builder.build_icmp(CompareOp::SLT.to_int(), l, r, "lt"),
          BinaryOp::LtEq  => ctx.builder.build_icmp(CompareOp::SLE.to_int(), l, r, "lt"),
          BinaryOp::Gt    => ctx.builder.build_icmp(CompareOp::SGT.to_int(), l, r, "gt"),
          BinaryOp::GtEq  => ctx.builder.build_icmp(CompareOp::SGE.to_int(), l, r, "lt"),
          BinaryOp::Eq    => ctx.builder.build_icmp(CompareOp::EQ.to_int(), l, r, "eq"),
          BinaryOp::NotEq => ctx.builder.build_icmp(CompareOp::NEQ.to_int(), l, r, "eq"),
        };
      }

      ExprKind::UnaryExpr(op, expr) => {
        let val = expr.codegen(ctx) ?? return None;
        return match op {
          UnaryOp::Negation => ctx.builder.build_neg(val, "neg"),
          UnaryOp::Bang => ctx.builder.build_not(val, "not")
        };
      }

      ExprKind::If(condition, if_case, else_case) => {
        let current_func = ctx.builder.get_insert_block().get_parent();
        let then_bb = ctx.context.append_basic_block(current_func, "then");
        let else_bb = ctx.context.append_basic_block(current_func, "else");
        let merge_bb = ctx.context.append_basic_block(current_func, "if_end");

        let condition = condition.codegen(ctx) ?? return None;
        ctx.builder.build_conditional_branch(condition, then_bb, else_bb);

        ctx.builder.position_at_end(then_bb);
        if_case.codegen_into_bb(ctx, merge_bb);

        ctx.builder.position_at_end(else_bb);
        if else_case is Some(block) 
          block.codegen_into_bb(ctx, merge_bb);
        else 
          ctx.builder.build_br(merge_bb);

        ctx.builder.position_at_end(merge_bb);
        return None;
      },

      ExprKind::Identifier(name) => {
        return ctx.load_variable(name) ?? return None;
      },

      ExprKind::Error => return None,
    }
    return None;
  }

  pub func llvm_string(&self, ctx: &CodegenContext) -> Result<LLVMValueRef, CodegenError> {
    match self.ty {
      Type::Boolean => {
        let v = self.codegen(ctx) ?? return Err(CodegenError::MissingValue(self.ty, self.span));
        let yes = ctx.builder.build_const_str_ptr("true", "true");
        let no = ctx.builder.build_const_str_ptr("false", "false");
        return LLVMBuildSelect(ctx.builder, v, yes, no, "bool_text");
      },
      Type::Int32 => self.codegen(ctx) ?? return Err(CodegenError::MissingValue(self.ty, self.span))
      _ => return Err(CodegenError::MissingValue(self.ty, self.span))
    }
  }
}

impl Codegen for Expression {
  pub func codegen(&self, ctx: &CodegenContext) -> Option<LLVMValueRef> {
    return self.codegen_value(ctx);
  }
}

pub enum ExprKind {
  Boolean => bool,
  IntLiteral => int64,

  BinaryExpr => {
      lhs: Unique<Expression>,
      op: BinaryOp,
      rhs: Unique<Expression>,
  },
  UnaryExpr => {
    op: UnaryOp,
    expr: Unique<Expression>
  }

  If => {
    condition: Unique<Expression>, 
    if_then: Unique<Block>, 
    if_else: Option<Unique<Block>>
  }

  Identifier => String,

  Error,
}

pub class Block {
  pub stmts: Vector<Statement>;
  /// The expression ending the block without `;`, the block's value. `None`
  /// if there's none, like for `{ return x; }`.
  pub value: Option<Expression>;

  pub func codegen_into_bb(&self, ctx: &CodegenContext, into_bb: BasicBlock) {
    for stmt in self.stmts {
      stmt.codegen(ctx);
    }
    if self.value is Some(value) 
      value.codegen(ctx);
    if !ctx.builder.get_insert_block().has_terminator() 
      ctx.builder.build_br(into_bb);
  }
}
