import modules;
import std::result::{Result};
import std::vector::{Vector};
import std::hashmap::{HashMap};
import statement;
import type;
import codegen_ctx;
import expression;
import std::math::{exp};
import operators;
import span;
import diagnostic;
import std::option::{Option};

pub class Sema {
  pub errors: &Vector<SemanticError>;

  variables: HashMap<String, SemaVariable> = HashMap();

  pub func check(mut &self, mut ast: &Vector<Statement>) {
    for stmt in ast {
      self.check_stmt(stmt);
    }
  }

  func check_stmt(mut &self, mut stmt: &Statement) {
    match stmt.kind {
      StmtKind::Assignment(var, rhs) => {
        let rhs_ty = self.check_expr(rhs);
        match self.variables.get(var) {
          None => self.errors.push(SemanticError::UnknownVariable(var, stmt.span))
          Some(lhs) => {
            if !lhs.is_mut 
              self.errors.push(SemanticError::ReassignToImmutableVariable(var, stmt.span));
            if lhs.ty != rhs_ty && lhs.ty != Type::Error && rhs_ty != Type::Error
              self.errors.push(SemanticError::TypeValueMismatch(var, lhs.ty, rhs_ty, stmt.span));
          }
        }
      } 

      StmtKind::Instantiation(name, ty, value, is_mut) => {
        let value_ty = self.check_expr(value);
        let def_ty = match ty {
          Some(t) => Some(self.resolve(t)) 
          None => None
        };
        if def_ty is Some(ty) && ty != value_ty && ty != Type::Error && value_ty != Type::Error 
          self.errors.push(SemanticError::TypeValueMismatch(name, ty, value_ty, value.span));

        let var = SemaVariable(def_ty ?? value_ty, is_mut);
        self.variables.set(name, var);
      } 

      StmtKind::Print(value) => {
        self.check_expr(value);
      } 
    }
  }

  func check_expr(mut &self, mut expr: &Expression) -> Type {
    let ty = match expr.kind {
      ExprKind::Array(values) => {
        match values.is_empty() {
          true => {
            self.errors.push(SemanticError::EmptyArrayUndefined(expr.span));
            Type::Error
          }
          false => {
            let elem_ty = self.check_expr(values[0]);
            for value in values {
              let ty = self.check_expr(value);
              if elem_ty != ty && elem_ty != Type::Error && ty != Type::Error
                self.errors.push(SemanticError::ArrayElementMismatch(elem_ty, ty, value.span));
            }
            Type::Array(shared(elem_ty), values.len() as uint32)
          }
        }
      }
      ExprKind::Boolean => Type::Boolean,
      ExprKind::IntLiteral => Type::Int32,
      ExprKind::Identifier(name) => match self.variables.get(name) {
        Some(var) => var.ty,
        None => {
          self.errors.push(SemanticError::UnknownVariable(name, expr.span));
          Type::Error
        }
      },
      ExprKind::BinaryExpr(lhs, op, rhs) => {
        let l = self.check_expr(lhs);
        let r = self.check_expr(rhs);
        l == Type::Error || r == Type::Error 
          ? Type::Error
          : match op.result_type(l,r) {
            Some(ty) => ty,
            None => {
              self.errors.push(SemanticError::InvalidOperands(op, l, r, expr.span));
              Type::Error
            }
          }
      }
      _ => Type::Error
    };

    expr.ty = ty;
    return ty;
  }

  func resolve(mut &self, ann: &TypeAnnotation) -> Type {
    match ann {
      TypeAnnotation::Array(elem, length) => {
        let elem_ty = self.resolve(elem);
        match self.eval_const(length) {
          Some(n) => return Type::Array(shared(elem_ty), n as uint32)
          None => {
            self.errors.push(SemanticError::ConstantExpected("array length", length.span));
            return Type::Error;
          }
        }
      }
      TypeAnnotation::Boolean => Type::Boolean
      TypeAnnotation::Int32 => Type::Int32
      TypeAnnotation::Named(def) => Type::Class(def)

    }
  }

  func eval_const(mut &self, expr: &Expression) -> Option<int64> {
    match expr.kind {
      ExprKind::IntLiteral(n) => n
      ExprKind::BinaryExpr(lhs, op, rhs) => {
        let l = self.eval_const(lhs) ?? return None;
        let r = self.eval_const(rhs) ?? return None;
        match op {
          BinaryOp::Add => l + r
          BinaryOp::Sub => l - r
          BinaryOp::Mul => l * r
          _ => {
            self.errors.push(SemanticError::NotImplementedYet("Constant floats", expr.span));
            return None;
          }
        }
      }
      _ => return None
    }
  }
}

pub class SemaVariable {
  pub ty: Type;
  pub is_mut: bool;
}
