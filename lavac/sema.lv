import modules;
import std::result::{Result};
import std::vector::{Vector};
import std::hashmap::{HashMap};
import statement;
import type;
import codegen_ctx;
import expression;
import std::math::{exp};
import operators;
import span;

pub class Sema {
  pub errors: &Vector<SemanticError>;

  variables: HashMap<String, SemaVariable> = HashMap();

  pub func check(mut &self, mut ast: &Vector<Statement>) {
    for stmt in ast {
      self.check_stmt(stmt);
    }
  }

  func check_stmt(mut &self, mut stmt: &Statement) {
    match stmt.kind {
      StmtKind::Assignment(var, val) => {
        if self.variables.get(var) is Some(v) && !v.is_mut 
          self.errors.push(SemanticError::ReassignToUnmutableVariable(var));
      } 

      StmtKind::Instantiation(name, ty, value, is_mut) => {
        let value_ty = self.check_expr(value);
        if ty is Some(t) && t != value_ty && t != Type::Error && value_ty != Type::Error 
          self.errors.push(SemanticError::TypeValueMissmatch(name, t, value_ty));

        let var = SemaVariable(ty ?? value_ty, is_mut);
        self.variables.set(name, var);
      } 

      StmtKind::Print(value) => {
        self.check_expr(value);
      } 
    }
  }

  func check_expr(mut &self, mut expr: &Expression) -> Type {
    let ty = match expr.kind {
      ExprKind::Boolean => Type::Boolean,
      ExprKind::IntLiteral => Type::Int32,
      ExprKind::Identifier(name) => match self.variables.get(name) {
        Some(var) => var.ty,
        None => {
          self.errors.push(SemanticError::UnknownVariable(name, expr.span));
          Type::Error
        }
      },
      ExprKind::BinaryExpr(lhs, op, rhs) => {
        let l = self.check_expr(lhs);
        let r = self.check_expr(rhs);
        l == Type::Error || r == Type::Error 
          ? Type::Error
          : match op.result_type(l,r) {
            Some(ty) => ty,
            None => {
              self.errors.push(SemanticError::InvalidOperands(op, l, r, expr.span));
              Type::Error
            }
          }
      }
      _ => Type::Error
    };

    expr.ty = ty;
    return ty;
  }
}

pub enum SemanticError {
  TypeValueMissmatch => {
    var: String,
    type: Type,
    val_type: Type,
  },
  InvalidOperands => {
    op: BinaryOp,
    lhs: Type,
    rhs: Type,
    span: Span
  },
  UnknownVariable => {
    name: String,
    span: Span
  },
  ReassignToUnmutableVariable => String
  
  pub func message(&self) -> String {
    match self {
      SemanticError::TypeValueMissmatch(_, type, val_ty) => "Defined type '" + type.to_string() + "' didn't match the values type '" + val_ty.to_string() + "'"
      SemanticError::InvalidOperands(op, lhs, rhs, _) => "The '" + op.to_string() + "' operation can't be used on '" + lhs.to_string() + "' and '" + rhs.to_string() + "'"
      SemanticError::UnknownVariable(name, _) => "'" + name + "' is an undefined variable"
      SemanticError::ReassignToUnmutableVariable(var) => "Tried reassigning a value to the unmutable Variable '" + var + "'"
    }
  } 
}

pub class SemaVariable {
  pub ty: Type;
  pub is_mut: bool;
}
