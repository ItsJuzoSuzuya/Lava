import lexer;
import std::path::{Path};
import modules;
import token;
import std::option::{Option};
import statement;
import std::vector::{Vector};
import std::result::{Result};
import expression;
import std::math::{exp};
import type;
import precidece;
import operators;
import program;
import span;
import diagnostic;

pub class Parser {
  lexer: Lexer;
  errors: &Vector<ParseError>;
  recovering: bool = false;

  pub func from_source(source: String, errors: &Vector<ParseError>) -> Parser {
    return Parser(Lexer(source), errors);
  }

  pub func parse_imports(mut &self) -> Vector<Import> {
    mut imports = Vector<Import>();
    while !self.peek().is_eof() {
      let token = self.next_token();

      if token.kind == TokenKind::Import {
        let mod = self.next_token();
        self.expect(TokenKind::Semicolon);
        let imp = Import(mod.as_string());
        imports.push(imp);
      }
    }

    return imports;
  }

  pub func parse(mut &self) -> Vector<Statement> {
    mut stmts = Vector<Statement>();
    while !self.peek().is_eof() {
      let stmt = self.parse_stmt();
      stmts.push(stmt);
    }

    return stmts;
  }

  pub func parse_stmt(mut &self) -> Statement {
    let token = self.peek();
    match token.kind {
      TokenKind::Let => { self.consume(); return self.parse_variable(false); }
      TokenKind::Mut => { self.consume(); return self.parse_variable(true); }
      TokenKind::Print => { self.consume(); return self.parse_print(); }
      _ => ()
    };

    let expr = self.parse_expr();
    if self.peek().kind == TokenKind::Assign && expr.kind is ExprKind::Identifier(name) {
      self.consume(); // consume '='
      let value = self.parse_expr();
      self.expect(TokenKind::Semicolon);
      return Statement(StmtKind::Assignment(name, value), token.span);
    }
    return Statement(StmtKind::Expression(expr), token.span);
  }

  pub func parse_variable(mut &self, is_mut: bool) -> Statement {
    let var = self.next_token().as_string();
    mut type: Option<Type> = None;
    if self.peek().kind == TokenKind::Colon {
      self.consume();
      type = self.parse_type();
    }

    self.expect(TokenKind::Assign);
    let val = self.parse_expr();
    let span = val.span;
    self.expect(TokenKind::Semicolon);

    return Statement(StmtKind::Instantiation(var, type, val, is_mut), span);
  }

  func parse_print(mut &self) -> Statement {
    self.expect(TokenKind::LParen);
    let expr = self.parse_expr();
    let span = expr.span;
    self.expect(TokenKind::RParen);
    self.expect(TokenKind::Semicolon);
    return Statement(StmtKind::Print(expr), span);
  } 

  pub func parse_expr(mut &self) -> Expression {
    return self.parse_level();
  }

  pub func parse_level(mut &self, level: Precidence = Precidence::Comparision) -> Expression {
    if level == Precidence::Primary 
      return self.parse_primary();

    if level == Precidence::Unary {
      if !level.has(self.peek().kind) 
        return self.parse_level(Precidence::Primary);

      let op = UnaryOp::from_token(self.next_token().kind);
      let expr = self.parse_level(Precidence::Unary);
      let ty = expr.ty;
      let span = expr.span;
      return Expression(ExprKind::UnaryExpr(op, unique(expr)), span, ty);
    }

    mut lhs = self.parse_level(level.next());
    while level.has(self.peek().kind) {
      let op = self.next_token();
      let rhs = self.parse_level(level.next());
      let ty = lhs.ty;
      lhs = Expression(ExprKind::BinaryExpr(unique(lhs), BinaryOp::from_token(op.kind), unique(rhs)), op.span, ty);
    }

    return lhs;
  }

  func parse_primary(mut &self) -> Expression {
    let token = self.next_token();
    match token.kind {
      TokenKind::If => self.parse_if(),
      TokenKind::True => Expression(ExprKind::Boolean(true), token.span, Type::Boolean),
      TokenKind::False => Expression(ExprKind::Boolean(false), token.span, Type::Boolean),

      TokenKind::IntLiteral(val) => Expression(ExprKind::IntLiteral(val), token.span, Type::Int32),

      TokenKind::Identifier(name) => Expression(ExprKind::Identifier(name), token.span, Type::Void)
      _ => {
        self.error(ParseError::ExpectedExpression(token));
        Expression(ExprKind::Error, token.span, Type::Error)
      }
    };
  }

  func parse_if(mut &self) -> Expression {
    let condition = self.parse_expr();
    self.expect(TokenKind::LBrace);
    let body = self.parse_block();
    let span = condition.span;
    let kind = ExprKind::If(unique(condition), unique(body), None);
    return Expression(kind, span, Type::Void);
  }

  func parse_type(mut &self) -> Option<Type> {
    let token = self.next_token();
    match token.kind {
      TokenKind::Int32Ty => Type::Int32
      TokenKind::BoolTy => Type::Boolean
      TokenKind::Identifier(name) => Type::Named(name),
      kind => {
        self.error(ParseError::UnexpectedToken(token, kind));
        None
      }
    }

  }

  // Parses a { } block. Doesnt consume the {.
  func parse_block(mut &self) -> Block {
    mut stmts: Vector<Statement> = Vector();
    while !self.peek().is_eof() && self.peek().kind != TokenKind::RBrace {
      let stmt = self.parse_stmt();
      if stmt.kind is StmtKind::Value(expr) {
        self.expect(TokenKind::RBrace);
        return Block(stmts, expr);
      } else {
        stmts.push(stmt);
      }
    }

    self.expect(TokenKind::RBrace);
    return Block(stmts, None);
  }

  // The next token. Whatever the lexer can't read is recorded and skipped, the
  // rest of the parser never sees it
  func next_token(mut &self) -> Token {
    while true {
      match self.lexer.next_token() {
        Ok(token) => return token,
        Err(message) => self.error(ParseError::Lex(message)),
      }
    }
  }

  func peek(mut &self) -> Token {
    while true {
      match self.lexer.peek() {
        Ok(t) => return t,
        Err(context) => {
          self.errors.push(ParseError::Lex(context));
          self.lexer.next_token();
        }
      }
    }
  }

  func consume(mut &self) {
    while true {
      match self.lexer.next_token() {
        Ok(_) => break,
        Err(context) => self.error(ParseError::Lex(context))
      }
    }
  }

  func expect(mut &self, expected_token: TokenKind) {
    let got = self.peek();

    if got.kind != expected_token 
      return self.error(ParseError::UnexpectedToken(Token(expected_token, got.span), got.kind));

    self.next_token();
    self.recovering = false;
  }

  func error(mut &self, err: ParseError){
    if !self.recovering 
      self.errors.push(err);

    self.recovering = true;
  }
}

