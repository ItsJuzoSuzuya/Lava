import span;
pub enum TokenKind {
  BoolTy,
  CharTy,
  Float32Ty,
  Float64Ty,
  Int8Ty,
  Int16Ty,
  Int32Ty,
  Int64Ty,
  StringTy,
  UInt8Ty,
  UInt16Ty,
  UInt32Ty,
  UInt64Ty,

  Break,
  Class,
  ConstructorLit,
  Continue,
  Else,
  Enum,
  Extern,
  False,
  For,
  Func,
  If,
  Impl,
  Let,
  Match,
  Mut,
  Print,
  Pub, 
  Return,
  SelfRef,
  Trait,
  True,
  While,
  Import,
  As,

  AndAnd,
  Arrow,
  CaretEq,
  ColonColon,
  DivideEq,
  DotDot,
  EqEq,
  GtEq,
  LtEq,
  MinusEq,
  MultiplyEq,
  NotEq,
  OrOr,
  PercentEq,
  PlusEq,
  QuestionQuestion,
  ThickArrow,

  Assign,
  BAnd,
  Bang,
  Caret,
  Colon,
  Comma,
  Divide,
  Dot,
  Gt,
  LBrace,
  LBracket,
  LParen,
  Lt,
  Minus,
  Multiply,
  Percent,
  Plus,
  Question,
  RBrace,
  RBracket,
  RParen,
  Semicolon,

  /// A byte like `'a'` or `'\n'`, an integer literal of its value.
  CharLiteral => uint8,
  FloatLiteral => float64,
  Identifier => String,
  IntLiteral => int64,
  StringLiteral => String,

  EOF

  /// Turns a whole word into a [`Token`].
  ///
  /// Keywords map to their own [`Token`], everything else becomes a
  /// [`Token::Identifier`].
  pub func from_string(token: &String) -> TokenKind {
    match token {
        "bool"          => TokenKind::BoolTy,
        "char"          => TokenKind::CharTy,
        "float32"       => TokenKind::Float32Ty,
        "float64"       => TokenKind::Float64Ty,
        "int8"          => TokenKind::Int8Ty,
        "int16"         => TokenKind::Int16Ty,
        "int32"         => TokenKind::Int32Ty,
        "int64"         => TokenKind::Int64Ty,
        "String"        => TokenKind::StringTy,
        "uint8"         => TokenKind::UInt8Ty,
        "uint16"        => TokenKind::UInt16Ty,
        "uint32"        => TokenKind::UInt32Ty,
        "uint64"        => TokenKind::UInt64Ty,

        "break"         => TokenKind::Break,
        "class"         => TokenKind::Class,
        "Constructor"   => TokenKind::ConstructorLit,
        "continue"      => TokenKind::Continue,
        "func"          => TokenKind::Func,
        "if"            => TokenKind::If,
        "else"          => TokenKind::Else,
        "while"         => TokenKind::While,
        "for"           => TokenKind::For,
        "impl"          => TokenKind::Impl,
        "false"         => TokenKind::False,
        "print"         => TokenKind::Print,
        "let"           => TokenKind::Let,
        "return"        => TokenKind::Return,
        "self"          => TokenKind::SelfRef,
        "trait"         => TokenKind::Trait,
        "true"          => TokenKind::True,
        "mut"           => TokenKind::Mut,
        "match"         => TokenKind::Match,
        "pub"           => TokenKind::Pub,
        "enum"          => TokenKind::Enum,
        "extern"        => TokenKind::Extern,
        "import"        => TokenKind::Import,
        "as"            => TokenKind::As,
        _               => TokenKind::Identifier(token.clone())
    }
  }
}

pub class Token {
  kind: TokenKind;
  span: Span;
}
