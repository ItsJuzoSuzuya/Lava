import std::path::{Path};
import std::vector::{Vector};

// --- HashMaps ---
//
// A draft moved here from the prelude, as it was there. It doesn't compile
// yet, so it's commented out until it's finished:

pub trait Hash {
  pub func hash(&self) -> int32;
}

pub class Bucket<Key, Value> {
  pairs: Vector<(Key, Value)>;
}

pub class HashMap<Key: Hash, Value> {
  buckets: Vector<Bucket<Key, Value>> = Vector(16);

  pub func set(key: Key, value: Value) {
    let hash: int32 = key.hash();

  }
}

impl Hash for String {
  pub func hash(&self) -> int32 {
    let p: uint64 = 53;
    let m: uint64 = 1e9 + 9;
    mut hash_value: uint64 = 0;
    mut p_pow: uint64 = 1;
    for c in self.bytes {
      hash_value = (hash_value + (c as uint32 + 1) * p_pow) % m;
      p_pow = (p_pow * p) % m;
    }
  }
}

impl Hash for Path {
  pub func hash(&self) -> int32 {
    return self.to_string().hash();
  }
}
