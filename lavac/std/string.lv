// std::string: working with text. `String` itself is part of the language,
// this module adds methods to it.
//
//   import std::string;
//
//   let parts = "a,b".split(',');
//   print("  hi  ".trim());
//   print("count: " + int_to_string(3));

import std::option::{Option};
import std::vector::{Vector};

pub func is_digit(c: char) -> bool {
  return c >= '0' && c <= '9';
}

pub func is_alpha(c: char) -> bool {
  return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z';
}

pub func is_alphanumeric(c: char) -> bool {
  return is_alpha(c) || is_digit(c);
}

pub func is_whitespace(c: char) -> bool {
  return c == ' ' || c == '\n' || c == '\t' || c == '\r';
}

impl String {
  pub func starts_with(&self, prefix: &String) -> bool {
    if prefix.len() > self.len() {
      return false;
    }
    return self.slice(0, prefix.len()) == prefix;
  }

  pub func ends_with(&self, suffix: &String) -> bool {
    if suffix.len() > self.len() {
      return false;
    }
    return self.slice(self.len() - suffix.len(), self.len()) == suffix;
  }

  // The text without `prefix` at its start, if it starts with it.
  pub func strip_prefix(&self, prefix: &String) -> Option<String> {
    if !self.starts_with(prefix) {
      return None;
    }
    Some(self.slice(prefix.len(), self.len()))
  }

  // The position of the first `needle` in the text, if there's one.
  pub func index_of(&self, needle: &String) -> Option<uint64> {
    if needle.len() > self.len() {
      return Option::None;
    }
    mut i: uint64 = 0;
    while i + needle.len() <= self.len() {
      if self.slice(i, i + needle.len()) == needle {
        return Option::Some(i);
      }
      i = i + 1;
    }
    return Option::None;
  }

  pub func contains(&self, needle: &String) -> bool {
    return self.index_of(needle).is_some();
  }

  // The text without whitespace at its start and end.
  pub func trim(&self) -> String {
    mut start: uint64 = 0;
    mut end = self.len();
    while start < end && is_whitespace(self.char_at(start)) {
      start = start + 1;
    }
    while end > start && is_whitespace(self.char_at(end - 1)) {
      end = end - 1;
    }
    return self.slice(start, end);
  }

  // The parts of the text between the `separator` bytes.
  pub func split(&self, separator: char) -> Vector<String> {
    mut parts = Vector<String>();
    mut start: uint64 = 0;
    mut i: uint64 = 0;
    while i < self.len() {
      if self.char_at(i) == separator {
        parts.push(self.slice(start, i));
        start = i + 1;
      }
      i = i + 1;
    }
    parts.push(self.slice(start, self.len()));
    return parts;
  }

  // The decimal number in the text, like `-42`, if it is one.
  pub func parse_int(&self) -> Option<int64> {
    if self.len() == 0 {
      return Option::None;
    }
    mut negative = false;
    mut i: uint64 = 0;
    if self.char_at(0) == '-' {
      negative = true;
      i = 1;
      if self.len() == 1 {
        return Option::None;
      }
    }
    mut value: int64 = 0;
    while i < self.len() {
      let c = self.char_at(i);
      if !is_digit(c) {
        return Option::None;
      }
      value = value * 10 + (c as uint8 - '0') as int64;
      i = i + 1;
    }
    if negative {
      return Option::Some(-value);
    }
    return Option::Some(value);
  }
}

// The strings of `parts` with `separator` between them.
pub func join(parts: &Vector<String>, separator: &String) -> String {
  mut joined = "";
  mut i: uint64 = 0;
  while i < parts.len() {
    if i > 0 {
      joined = joined + separator;
    }
    joined = joined + parts.get(i);
    i = i + 1;
  }
  return joined;
}

// The text of `c`, like `"a"` for `'a'`.
pub func char_to_string(c: char) -> String {
  mut bytes = Buffer<char>(1);
  bytes.set(0, c);
  return String(bytes, 1);
}

// `value` in decimal, like `"-42"`.
pub func int_to_string(value: int64) -> String {
  mut digits = Buffer<char>(24);
  let length = c_snprintf(digits, digits.capacity(), "%lld", value);
  return String(digits, length as uint64);
}

// `value` in decimal, like `"2.5"`.
pub func float_to_string(value: float64) -> String {
  mut digits = Buffer<char>(32);
  let length = c_snprintf(digits, digits.capacity(), "%g", value);
  return String(digits, length as uint64);
}

extern "snprintf" func c_snprintf(into: &Buffer<char>, size: uint64, format: String, ..) -> int32;
