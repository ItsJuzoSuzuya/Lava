// std::env: the program's environment.
//
//   import std::env;
//
//   func main() {
//     match env::args().collect() {
//       [_, name] => print("hello " + name),
//       _ => print("usage: hello <name>"),
//     }
//   }

import std::option::{Option};
import std::vector::{Vector};

// The program's command line arguments, one after the other. The first one
// is how the program was started.
pub class Args {
  index: int32 = 0;

  Constructor();

  // The next argument, `Option::None` after the last one.
  pub func next(mut &self) -> Option<String> {
    if self.index >= arg_count() {
      return Option::None;
    }
    let value = argument(self.index);
    self.index = self.index + 1;
    return Option::Some(value);
  }

  // How many arguments are left.
  pub func len(&self) -> uint64 {
    return (arg_count() - self.index) as uint64;
  }

  // The arguments that are left, in a list.
  pub func collect(mut &self) -> Vector<String> {
    mut all = Vector<String>();
    while self.index < arg_count() {
      all.push(argument(self.index));
      self.index = self.index + 1;
    }
    return all;
  }
}

// The program's command line arguments, see `Args`.
pub func args() -> Args {
  return Args();
}

// The command line argument at `index`, which exists.
func argument(index: int32) -> String {
  let bytes = arg_bytes(index);
  let length = bytes.capacity();
  return String(bytes, length);
}
