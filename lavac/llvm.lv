pub extern func LLVMBuildCall2(builder: LLVMBuilderRef, ty: LLVMTypeRef, function: LLVMValueRef, args: &[LLVMValueRef], count: uint32, name: String) -> LLVMValueRef;
pub extern func LLVMBuildSelect(builder: LLVMBuilderRef, condition: LLVMValueRef, then_value: LLVMValueRef, else_value: LLVMValueRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildPhi(builder: LLVMBuilderRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMAddIncoming(phi: LLVMValueRef, values: &[LLVMValueRef], blocks: &[LLVMBasicBlockRef], count: uint32);

pub extern func LLVMBuildTrunc(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildZExt(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildSExt(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildFPTrunc(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildFPExt(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildSIToFP(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildUIToFP(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildFPToSI(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;
pub extern func LLVMBuildFPToUI(builder: LLVMBuilderRef, value: LLVMValueRef, ty: LLVMTypeRef, name: String) -> LLVMValueRef;

// LLVMIntPredicate, how `LLVMBuildICmp` compares.
pub enum LLVMIntPredicate {
  LLVMIntEQ,
  LLVMIntNE,
  LLVMIntUGT,
  LLVMIntUGE,
  LLVMIntULT,
  LLVMIntULE,
  LLVMIntSGT,
  LLVMIntSGE,
  LLVMIntSLT,
  LLVMIntSLE;

  // Its value in C.
  pub func to_int(&self) -> int32 {
    match self {
      LLVMIntPredicate::LLVMIntEQ => 32,
      LLVMIntPredicate::LLVMIntNE => 33,
      LLVMIntPredicate::LLVMIntUGT => 34,
      LLVMIntPredicate::LLVMIntUGE => 35,
      LLVMIntPredicate::LLVMIntULT => 36,
      LLVMIntPredicate::LLVMIntULE => 37,
      LLVMIntPredicate::LLVMIntSGT => 38,
      LLVMIntPredicate::LLVMIntSGE => 39,
      LLVMIntPredicate::LLVMIntSLT => 40,
      LLVMIntPredicate::LLVMIntSLE => 41,
    }
  }
}

// LLVMRealPredicate, how `LLVMBuildFCmp` compares. The ordered ones are false for NaN.
pub enum LLVMRealPredicate {
  LLVMRealOEQ,
  LLVMRealOGT,
  LLVMRealOGE,
  LLVMRealOLT,
  LLVMRealOLE,
  LLVMRealONE,
  LLVMRealUNE;

  // Its value in C.
  pub func to_int(&self) -> int32 {
    match self {
      LLVMRealPredicate::LLVMRealOEQ => 1,
      LLVMRealPredicate::LLVMRealOGT => 2,
      LLVMRealPredicate::LLVMRealOGE => 3,
      LLVMRealPredicate::LLVMRealOLT => 4,
      LLVMRealPredicate::LLVMRealOLE => 5,
      LLVMRealPredicate::LLVMRealONE => 6,
      LLVMRealPredicate::LLVMRealUNE => 14,
    }
  }
}
