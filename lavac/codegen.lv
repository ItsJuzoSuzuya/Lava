import codegen_ctx;
import llvm;
import type;
import std::option::{Option};
import span;

pub trait Codegen {
  pub func codegen(&self, mut ctx: &CodegenContext) -> Option<LLVMValueRef>;
}

pub enum CodegenError {
  MissingValue => {
    ty: type::Type, 
    span: Span
  },
  UndefinedVariable => String 

  pub func message(&self) -> String {
    match self {
      CodegenError::MissingValue(ty, _) => "internal error: an expression of type " + ty.to_string() + " gave no value",
      CodegenError::UndefinedVariable(name) => "Use of undefined variable: " + name,
    }
  }
}
