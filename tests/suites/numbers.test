=== int8
let x: int8 = 100;
print(x);
--- output
100

=== int8 max
let x: int8 = 127;
print(x);
--- output
127

=== int8 min
let x: int8 = -128;
print(x);
--- output
-128

=== int8 too big
let x: int8 = 128;
--- error
literal '128' doesn't fit into 'int8'

=== int8 too small
let x: int8 = -129;
--- error
literal '-129' doesn't fit into 'int8'

=== int16
let x: int16 = 30000;
print(x);
--- output
30000

=== int16 max
let x: int16 = 32767;
print(x);
--- output
32767

=== int16 too big
let x: int16 = 32768;
--- error
literal '32768' doesn't fit into 'int16'

=== int32 max
let x: int32 = 2147483647;
print(x);
--- output
2147483647

=== int32 min
let x: int32 = -2147483648;
print(x);
--- output
-2147483648

=== int32 too big
let x: int32 = 2147483648;
--- error
literal '2147483648' doesn't fit into 'int32'

=== untyped literal too big for int32
let x = 3000000000;
--- error
literal '3000000000' doesn't fit into 'int32'

=== printed literal too big for int32
print(3000000000);
--- error
literal '3000000000' doesn't fit into 'int32'

=== untyped literal expression too big for int32
let x = 3000000000 + 1;
--- error
literal '3000000000' doesn't fit into 'int32'

=== big literal next to an int64 value
let a: int64 = 1;
print(a + 3000000000);
--- output
3000000001

=== big literal inside a function body
func f() {
  let x = 3000000000;
}
--- error
literal '3000000000' doesn't fit into 'int32'

=== big literal as int64 argument
func show(x: int64) {
  print(x);
}
show(3000000000);
--- output
3000000000

=== int64
let x: int64 = 9000000000;
print(x);
--- output
9000000000

=== int64 max
let x: int64 = 9223372036854775807;
print(x);
--- output
9223372036854775807

=== int64 negative
let x: int64 = -9000000000;
print(x);
--- output
-9000000000

=== literal too big for int64
let x: int64 = 9223372036854775808;
--- error
doesn't fit into int64

=== uint8
let x: uint8 = 200;
print(x);
--- output
200

=== uint8 max
let x: uint8 = 255;
print(x);
--- output
255

=== uint8 too big
let x: uint8 = 256;
--- error
literal '256' doesn't fit into 'uint8'

=== uint8 negative
let x: uint8 = -1;
--- error
literal '-1' doesn't fit into 'uint8'

=== uint16 max
let x: uint16 = 65535;
print(x);
--- output
65535

=== uint16 too big
let x: uint16 = 65536;
--- error
literal '65536' doesn't fit into 'uint16'

=== uint32 above int32 max
let x: uint32 = 4000000000;
print(x);
--- output
4000000000

=== uint32 max
let x: uint32 = 4294967295;
print(x);
--- output
4294967295

=== uint32 too big
let x: uint32 = 4294967296;
--- error
literal '4294967296' doesn't fit into 'uint32'

=== uint64
let x: uint64 = 18000000000;
print(x);
--- output
18000000000

=== uint64 negative
let x: uint64 = -5;
--- error
literal '-5' doesn't fit into 'uint64'

=== float32
let x: float32 = 2.5;
print(x);
--- output
2.500000

=== float64
let x: float64 = 0.125;
print(x);
--- output
0.125000

=== untyped float literal is float64
let x = 1.25;
let y: float64 = x;
print(y);
--- output
1.250000

=== float with many digits
let x: float64 = 3.14159;
print(x);
--- output
3.141590

=== float zero
let x = 0.0;
print(x);
--- output
0.000000

=== untyped int literal is int32
let x = 5;
let y: int32 = x;
print(y);
--- output
5

=== int literal isn't a float
let x: float32 = 5;
--- error
type 'int32' does not match 'float32' in variable declaration

=== float literal isn't an int
let x: int32 = 2.5;
--- error
type 'float64' does not match 'int32' in variable declaration

=== literal adapts to function parameter
func show(x: uint8) {
  print(x);
}
show(255);
--- output
255

=== literal out of range for function parameter
func show(x: uint8) {
  print(x);
}
show(256);
--- error
literal '256' doesn't fit into 'uint8'

=== literal adapts to return type
func big() -> int64 {
  return 5000000000;
}
print(big());
--- output
5000000000

=== literal adapts on assignment
mut x: uint16 = 1;
x = 60000;
print(x);
--- output
60000

=== literal expression adapts as a whole
let x: int64 = 3000000000 + 3000000000;
print(x);
--- output
6000000000

=== float literal adapts to float32 parameter
func show(x: float32) {
  print(x);
}
show(0.5);
--- output
0.500000

=== all type keywords parse
let a: int8 = 1;
let b: int16 = 2;
let c: int32 = 3;
let d: int64 = 4;
let e: uint8 = 5;
let f: uint16 = 6;
let g: uint32 = 7;
let h: uint64 = 8;
let i: float32 = 9.0;
let j: float64 = 10.0;
print(a);
print(b);
print(c);
print(d);
print(e);
print(f);
print(g);
print(h);
print(i);
print(j);
--- output
1
2
3
4
5
6
7
8
9.000000
10.000000

=== sqrt of a float literal
print(sqrt(2.0));
--- output
1.414214

=== sqrt of a perfect square
print(sqrt(16.0));
--- output
4.000000

=== sqrt of a float32 variable
let x: float32 = 6.25;
print(sqrt(x));
--- output
2.500000

=== sqrt of an int literal widens to float64
print(sqrt(4));
--- output
2.000000

=== sqrt result in arithmetic
let x: float64 = sqrt(9.0) + 1.0;
print(x);
--- output
4.000000

=== sqrt result doesn't narrow to float32
let x: float32 = sqrt(9.0);
--- error
type 'float64' does not match 'float32' in variable declaration
