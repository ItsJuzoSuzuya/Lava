=== create an instance and read a public field
class Point {
  pub x: int32 = x;
  pub y: int32 = y;

  Constructor(x: int32, y: int32);
}
let p = Point { x: 3, y: 4 };
print(p.x);
print(p.y);
--- output
3
4

=== brace init fields in any order
class Point {
  pub x: int32 = x;
  pub y: int32 = y;

  Constructor(x: int32, y: int32);
}
let p = Point { y: 4, x: 3 };
print(p.x);
print(p.y);
--- output
3
4

=== brace init with explicit type
class Point {
  pub x: int32 = x;
  pub y: int32 = y;

  Constructor(x: int32, y: int32);
}
let p: Point = { x: 1, y: 2 };
print(p.y);
--- output
2

=== constructor called like a function
class Point {
  pub x: int32 = x;
  pub y: int32 = y;

  Constructor(x: int32, y: int32);
}
let p = Point(5, 6);
print(p.x);
print(p.y);
--- output
5
6

=== string field
class Person {
  pub name: String = name;

  Constructor(name: String);
}
let p = Person { name: "Ada" };
print(p.name);
--- output
Ada

=== fields of different types
class Thing {
  pub id: int64 = id;
  pub ok: bool = ok;
  pub weight: float32 = weight;
  pub label: String = label;

  Constructor(id: int64, ok: bool, weight: float32, label: String);
}
let t = Thing { id: 9000000000, ok: true, weight: 1.5, label: "box" };
print(t.id);
print(t.ok);
print(t.weight);
print(t.label);
--- output
9000000000
true
1.500000
box

=== field default that isn't a constructor parameter
class Counter {
  pub count: int32 = 10;
  pub step: int32 = step;

  Constructor(step: int32);
}
let c = Counter { step: 2 };
print(c.count);
print(c.step);
--- output
10
2

=== field in arithmetic
class Point {
  pub x: int32 = x;
  pub y: int32 = y;

  Constructor(x: int32, y: int32);
}
let p = Point { x: 3, y: 4 };
print(p.x * p.x + p.y * p.y);
--- output
25

=== method without return value
class Dog {
  name: String = name;

  Constructor(name: String);

  pub func bark(&self) {
    print(self.name);
  }
}
let d = Dog { name: "Rex" };
d.bark();
--- output
Rex

=== method with return value
class Rect {
  w: int32 = w;
  h: int32 = h;

  Constructor(w: int32, h: int32);

  pub func area(&self) -> int32 {
    return self.w * self.h;
  }
}
let r = Rect { w: 3, h: 5 };
print(r.area());
--- output
15

=== method with parameters
class Adder {
  base: int32 = base;

  Constructor(base: int32);

  pub func add(&self, x: int32) -> int32 {
    return self.base + x;
  }
}
let a = Adder { base: 100 };
print(a.add(23));
--- output
123

=== method calling another method
class Num {
  value: int32 = value;

  Constructor(value: int32);

  pub func get(&self) -> int32 {
    return self.value;
  }

  pub func twice(&self) -> int32 {
    return self.get() * 2;
  }
}
let n = Num { value: 21 };
print(n.twice());
--- output
42

=== method calling a private method
class Secret {
  value: int32 = value;

  Constructor(value: int32);

  func hidden(&self) -> int32 {
    return self.value;
  }

  pub func reveal(&self) -> int32 {
    return self.hidden();
  }
}
let s = Secret { value: 7 };
print(s.reveal());
--- output
7

=== method called without receiver is an error
class Secret {
  value: int32 = value;

  Constructor(value: int32);

  func hidden(&self) -> int32 {
    return self.value;
  }

  pub func reveal(&self) -> int32 {
    return hidden();
  }
}
let s = Secret { value: 7 };
print(s.reveal());
--- error
'hidden' is a method of 'Secret', call it as `self.hidden(...)`

=== static function called without class is an error
class Secret {
  func seven() -> int32 {
    return 7;
  }

  pub func reveal(&self) -> int32 {
    return seven();
  }
}
--- error
'seven' is a method of 'Secret', call it as `Secret::seven(...)`

=== static function calling a method without receiver is an error
class Secret {
  value: int32 = value;

  Constructor(value: int32);

  func hidden(&self) -> int32 {
    return self.value;
  }

  pub func make() -> int32 {
    return hidden();
  }
}
print(Secret::make());
--- error
'hidden' is a method of 'Secret', call it as `self.hidden(...)`

=== free function wins over a method of the same name
func value() -> int32 {
  return 1;
}
class Box {
  func value(&self) -> int32 {
    return 2;
  }

  pub func get(&self) -> int32 {
    return value() + self.value();
  }
}
let b = Box();
print(b.get());
--- output
3

=== two instances are independent
class Box {
  pub v: int32 = v;

  Constructor(v: int32);
}
let a = Box { v: 1 };
let b = Box { v: 2 };
print(a.v);
print(b.v);
--- output
1
2

=== two classes
class A {
  pub v: int32 = v;

  Constructor(v: int32);
}
class B {
  pub w: int32 = w;

  Constructor(w: int32);
}
let a = A { v: 1 };
let b = B { w: 2 };
print(a.v + b.w);
--- output
3

=== assign a field of a mut instance
class Box {
  pub v: int32 = v;

  Constructor(v: int32);
}
mut b = Box { v: 1 };
b.v = 5;
print(b.v);
--- output
5

=== assigning a field of a let instance is an error
class Box {
  pub v: int32 = v;

  Constructor(v: int32);
}
let b = Box { v: 1 };
b.v = 5;
--- error
Tried reassigning a value to the unmutable Variable 'b'

=== private field can't be read from outside
class Box {
  v: int32 = v;

  Constructor(v: int32);
}
let b = Box { v: 1 };
print(b.v);
--- error
Tried accessing a private field 'v'

=== private method can't be called from outside
class Box {
  v: int32 = v;

  Constructor(v: int32);

  func hidden(&self) -> int32 {
    return self.v;
  }
}
let b = Box { v: 1 };
print(b.hidden());
--- error
Tried calling a private function 'hidden'

=== unknown field in brace init
class Box {
  pub v: int32 = v;

  Constructor(v: int32);
}
let b = Box { w: 1 };
--- error
class 'Box' has no field 'w'

=== missing field in brace init
class Point {
  pub x: int32 = x;
  pub y: int32 = y;

  Constructor(x: int32, y: int32);
}
let p = Point { x: 1 };
--- error
missing argument 1 for 'Point'

=== wrong field type in brace init
class Box {
  pub v: int32 = v;

  Constructor(v: int32);
}
let b = Box { v: "text" };
--- error
type 'String' does not match 'int32' in struct initializer field

=== literal adapts to field type
class Box {
  pub v: uint8 = v;

  Constructor(v: uint8);
}
let b = Box { v: 255 };
print(b.v);
--- output
255

=== literal out of range for field type
class Box {
  pub v: uint8 = v;

  Constructor(v: uint8);
}
let b = Box { v: 256 };
--- error
literal '256' doesn't fit into 'uint8'

=== reading an unknown field is an error
class Box {
  pub v: int32 = v;

  Constructor(v: int32);
}
let b = Box { v: 1 };
print(b.nothing);
--- error
class 'Box' has no field 'nothing'

=== field access on a non object
let x = 5;
print(x.y);
--- error
is not an object

=== unknown method on an int
let x = 5;
x.go();
--- error
unknown function 'go'

=== constructor marked pub is an error
class Box {
  v: int32 = v;

  pub Constructor(v: int32);
}
--- error
constructors are always public

=== instance passed to a function
class Box {
  pub v: int32 = v;

  Constructor(v: int32);
}
func show(b: Box) {
  print(b.v);
}
show(Box { v: 8 });
--- output
8

=== instance returned from a function
class Box {
  pub v: int32 = v;

  Constructor(v: int32);
}
func make(v: int32) -> Box {
  return Box { v: v };
}
let b = make(9);
print(b.v);
--- output
9

=== field of a field
class Inner {
  pub v: int32 = v;

  Constructor(v: int32);
}
class Outer {
  pub inner: Inner = inner;

  Constructor(inner: Inner);
}
let o = Outer { inner: Inner { v: 7 } };
print(o.inner.v);
--- output
7

=== assign a field of a field
class Inner {
  pub v: int32 = v;

  Constructor(v: int32);
}
class Outer {
  pub inner: Inner = inner;

  Constructor(inner: Inner);
}
mut o = Outer { inner: Inner { v: 7 } };
o.inner.v = 8;
print(o.inner.v);
--- output
8

=== assigning a field of a field needs mut
class Inner {
  pub v: int32 = v;

  Constructor(v: int32);
}
class Outer {
  pub inner: Inner = inner;

  Constructor(inner: Inner);
}
let o = Outer { inner: Inner { v: 7 } };
o.inner.v = 8;
--- error
Tried reassigning a value to the unmutable Variable 'o'

=== method on a field
class Inner {
  v: int32 = v;

  Constructor(v: int32);

  pub func get(&self) -> int32 {
    return self.v;
  }
}
class Outer {
  pub inner: Inner = inner;

  Constructor(inner: Inner);
}
let o = Outer { inner: Inner { v: 5 } };
print(o.inner.get());
--- output
5

=== method on a field of self
class Inner {
  v: int32 = v;

  Constructor(v: int32);

  pub func get(&self) -> int32 {
    return self.v;
  }
}
class Outer {
  inner: Inner = inner;

  Constructor(inner: Inner);

  pub func inner_value(&self) -> int32 {
    return self.inner.get() + 1;
  }
}
let o = Outer { inner: Inner { v: 5 } };
print(o.inner_value());
--- output
6

=== mutating method on a field of self
class Counter {
  pub count: int32 = count;

  Constructor(count: int32);

  pub func bump(mut &self) {
    self.count = self.count + 1;
  }
}
class Holder {
  pub counter: Counter = counter;

  Constructor(counter: Counter);

  pub func bump_counter(mut &self) {
    self.counter.bump();
  }
}
mut h = Holder { counter: Counter { count: 1 } };
h.bump_counter();
h.counter.bump();
print(h.counter.count);
--- output
3

=== mutating method on a field needs mut
class Counter {
  pub count: int32 = count;

  Constructor(count: int32);

  pub func bump(mut &self) {
    self.count = self.count + 1;
  }
}
class Holder {
  pub counter: Counter = counter;

  Constructor(counter: Counter);
}
let h = Holder { counter: Counter { count: 1 } };
h.counter.bump();
--- error
method 'bump' changes 'self', so 'h' has to be mutable

=== field of a call result
class Point {
  pub x: int32 = x;

  Constructor(x: int32);
}
func make() -> Point {
  return Point { x: 4 };
}
print(make().x);
--- output
4

=== method on a call result
class Point {
  x: int32 = x;

  Constructor(x: int32);

  pub func doubled(&self) -> int32 {
    return self.x * 2;
  }
}
func make() -> Point {
  return Point { x: 4 };
}
print(make().doubled());
--- output
8

=== method returning an object with a method
class Point {
  x: int32 = x;

  Constructor(x: int32);

  pub func moved(&self, by: int32) -> Point {
    return Point { x: self.x + by };
  }

  pub func get(&self) -> int32 {
    return self.x;
  }
}
let p = Point { x: 1 };
print(p.moved(2).moved(3).get());
--- output
6

=== field through a reference parameter
class Inner {
  pub v: int32 = v;

  Constructor(v: int32);
}
class Outer {
  pub inner: Inner = inner;

  Constructor(inner: Inner);
}
func show(o: &Outer) {
  print(o.inner.v);
}
let o = Outer { inner: Inner { v: 3 } };
show(&o);
--- output
3

=== method through a reference parameter
class Point {
  x: int32 = x;

  Constructor(x: int32);

  pub func get(&self) -> int32 {
    return self.x;
  }
}
func show(p: &Point) {
  print(p.get());
}
let p = Point { x: 2 };
show(&p);
--- output
2

=== enum tag of a field
enum Light {
  Red => int32,
  Green => int32
}
class Lamp {
  pub light: Light = light;

  Constructor(light: Light);
}
let l = Lamp { light: Light::Green(0) };
print(l.light.tag);
--- output
1

=== private field of a field is an error
class Inner {
  v: int32 = v;

  Constructor(v: int32);
}
class Outer {
  pub inner: Inner = inner;

  Constructor(inner: Inner);
}
let o = Outer { inner: Inner { v: 7 } };
print(o.inner.v);
--- error
Tried accessing a private field 'v'

=== without a Constructor the fields without default are the parameters
class Point {
  pub x: int32;
  pub y: int32;
  pub label: String = "point";
}
let p = Point(1, 2);
print(p.x + p.y);
print(p.label);
let q = Point { y: 5, x: 4 };
print(q.x * q.y);
--- output
3
point
20

=== a Constructor without parameters runs after the fields are set
class Range {
  pub start: uint64;
  pub end: uint64;
  pub size: uint64 = 0;

  Constructor {
    if self.start > self.end {
      panic("start after end");
    }
    self.size = self.end - self.start;
  }
}
let r = Range(3, 10);
print(r.size);
--- output
7

=== a generic class gets a constructor from its fields too
class Box<T> {
  pub value: T;
}
let b = Box(7);
print(b.value);
let s = Box<String>("text");
print(s.value);
--- output
7
text

=== a class without fields is made with no arguments
class Empty {
}
let e = Empty();
print(1);
--- output
1

=== a missing field value is an error
class P {
  pub x: int32;
  pub y: int32;
}
let p = P(1);
--- error
missing argument 1 for 'P'

=== a function without self is called on the type
class Block {
  pub name: String;

  pub func create(name: String) -> Block {
    Block(name)
  }

  pub func empty() -> Block {
    Block("")
  }

  pub func named(first: String, second: String) -> Block {
    Block(first + second)
  }
}
print(Block::create("entry").name);
print(Block::empty().name.len());
print(Block::named("a", "b").name);
--- output
entry
0
ab

=== an enum's function without self is called on the enum, its variants stay variants
enum Color {
  Red,
  Green;

  pub func default() -> Color {
    Color::Green
  }

  pub func is_red(&self) -> bool {
    match self {
      Color::Red => true,
      Color::Green => false,
    }
  }
}
print(Color::default().is_red());
print(Color::Red.is_red());
--- output
false
true
