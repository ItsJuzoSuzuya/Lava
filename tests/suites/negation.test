=== negative literal
print(-5);
--- output
-5

=== negative literal in variable
let x = -42;
print(x);
--- output
-42

=== negative float literal
print(-2.5);
--- output
-2.500000

=== negative float32
let x: float32 = -0.75;
print(x);
--- output
-0.750000

=== negate a variable
let x = 7;
print(-x);
--- output
-7

=== negate a float variable
let x: float64 = 1.5;
print(-x);
--- output
-1.500000

=== negation binds tighter than addition
let x = 7;
print(-x + 1);
--- output
-6

=== subtracting a negative
let x = 7;
print(x - -3);
--- output
10

=== double negation
let x = 7;
print(--x);
--- output
7

=== double negation of a literal
print(--4);
--- output
4

=== negate in multiplication
let x: float32 = -2.5;
print(-x * 2.0);
--- output
5.000000

=== negative literal adapts to int16
let x: int16 = 10;
print(x + -20);
--- output
-10

=== negative literal as argument
func show(x: int64) {
  print(x);
}
show(-9000000000);
--- output
-9000000000

=== negate a function call
func five() -> int32 {
  return 5;
}
print(-five());
--- output
-5

=== negate zero
print(-0);
--- output
0

=== negating a uint is an error
let x: uint8 = 5;
print(-x);
--- error
cannot negate a value of type 'uint8'

=== negating a uint64 is an error
let x: uint64 = 5;
print(-x);
--- error
cannot negate a value of type 'uint64'

=== negating a string is an error
let s = "hi";
print(-s);
--- error
cannot negate a value of type 'String'

=== negating a bool is an error
let b = true;
print(-b);
--- error
cannot negate a value of type
