=== match an int literal
let x = 3;
match x {
  1 => print("one"),
  3 => print("three"),
  _ => print("other"),
}
--- output
three

=== match falls through to wildcard
let x = 9;
match x {
  1 => print("one"),
  3 => print("three"),
  _ => print("other"),
}
--- output
other

=== match without matching arm does nothing
let x = 9;
match x {
  1 => print("one"),
}
print("after");
--- output
after

=== match on uint8
let x: uint8 = 200;
match x {
  200 => print("big"),
  _ => print("small"),
}
--- output
big

=== match on int64
let x: int64 = 5000000000;
match x {
  5000000000 => print("huge"),
  _ => print("no"),
}
--- output
huge

=== match negative literal
let x = -2;
match x {
  -2 => print("minus two"),
  _ => print("no"),
}
--- output
minus two

=== pattern literal out of range for the scrutinee
let x: uint8 = 1;
match x {
  300 => print("no"),
  _ => print("ok"),
}
--- error
literal '300' doesn't fit into 'uint8'

=== match a bool
let b = true;
match b {
  true => print("yes"),
  false => print("no"),
}
--- output
yes

=== match a false bool
let b = false;
match b {
  true => print("yes"),
  false => print("no"),
}
--- output
no

=== match arm with block
let x = 2;
match x {
  2 => {
    print("two");
    print("still two");
  }
  _ => print("other"),
}
--- output
two
still two

=== match on a function result
func pick() -> int32 {
  return 1;
}
match pick() {
  1 => print("picked one"),
  _ => print("other"),
}
--- output
picked one

=== match inside a function
func describe(x: int32) {
  match x {
    0 => print("zero"),
    _ => print("not zero"),
  }
}
describe(0);
describe(5);
--- output
zero
not zero

=== code after match runs
let x = 1;
match x {
  1 => print("one"),
  _ => print("other"),
}
print("done");
--- output
one
done

=== pattern of wrong type
let x = 1;
match x {
  "one" => print("one"),
  _ => print("other"),
}
--- error
match arm pattern

=== invalid pattern
let x = 1;
match x {
  + => print("no"),
}
--- error
is not a valid pattern

=== match gives a value
let n = 2;
let name = match n {
  1 => "one",
  2 => "two",
  _ => "many",
};
print(name);
--- output
two

=== match on an option as a value
import std::option::{Option};
let some = Option::Some(5);
let none: Option<int32> = Option::None;
let a = match some {
  Option::Some(v) => v * 2,
  Option::None => 0,
};
let b = match none {
  Option::Some(v) => v * 2,
  Option::None => -1,
};
print(a);
print(b);
--- output
10
-1

=== block arm gives its last expression without semicolon
let n = 3;
let result = match n {
  3 => {
    let doubled = n * 2;
    print("computing");
    doubled + 1
  }
  _ => 0,
};
print(result);
--- output
computing
7

=== match value directly in an expression
let flag = true;
print(10 + match flag {
  true => 1,
  false => 2,
});
--- output
11

=== match as a return value
func describe(n: int32) -> String {
  return match n % 2 {
    0 => "even",
    _ => "odd",
  };
}
print(describe(4));
print(describe(7));
--- output
even
odd

=== arms can leave instead of giving a value
func first_even(values: int32[3]) -> int32 {
  mut i = 0;
  while i < 3 {
    let v = values[i];
    let half = match v % 2 {
      0 => v / 2,
      _ => {
        i = i + 1;
        continue;
      }
    };
    return half;
  }
  return -1;
}
print(first_even({3, 8, 5}));
--- output
4

=== panic leaves an arm too
import std::option::{Option};
let value: Option<int32> = Option::Some(3);
let n = match value {
  Option::Some(v) => v,
  Option::None => panic("no value"),
};
print(n);
--- output
3

=== the expected type adapts literal values
let big: int64 = match 1 {
  1 => 3000000000,
  _ => 0,
};
print(big);
--- output
3000000000

=== a binding pattern matches any number
import std::string::{int_to_string};
let n = 42;
let text = match n {
  0 => "zero",
  other => int_to_string(other as int64),
};
print(text);
--- output
42

=== match value owning memory
import std::vector::{Vector};
let words = match 1 {
  1 => {
    mut v = Vector<String>();
    v.push("a");
    v
  }
  _ => Vector<String>(),
};
print(words.len());
--- output
1

=== different value types are an error
let x = match 1 {
  1 => 5,
  _ => "five",
};
--- error
type 'String' does not match 'int32' in match arm value

=== missing case is an error
import std::option::{Option};
let o: Option<int32> = Option::None;
let x = match o {
  Option::Some(v) => v,
};
--- error
a match giving a value has to handle every case

=== number match needs a wildcard
let x = match 3 {
  1 => 1,
  2 => 2,
};
--- error
a match giving a value has to handle every case

=== arm without value is an error
let x = match 3 {
  1 => 1,
  _ => {
    print(2);
  }
};
--- error
this arm gives no value

=== match of print calls gives no value
let x = match 3 {
  _ => print(1),
};
--- error
this match gives no value

=== match statements still need no value or every case
match 5 {
  1 => print("one"),
}
print("done");
--- output
done

=== is binds in the then branch
import std::option::{Option};
let a: Option<int32> = Some(4);
if a is Some(v) {
  print(v);
}
print(a is None);
--- output
4
false

=== is binds in the rest of an && chain
import std::option::{Option};
func find(n: int32) -> Option<int32> {
  return n > 2 ? None : Some(n * 10);
}
if find(2) is Some(v) && v > 15 {
  print(v);
}
if find(1) is Some(v) && v > 15 {
  print(v);
}
--- output
20

=== is keeps the outer name in else and afterwards
import std::option::{Option};
let v = 99;
let a: Option<int32> = None;
if a is Some(v) {
  print(v);
} else {
  print(v);
}
print(v);
--- output
99
99

=== is on a temporary owning value
import std::result::{Result};
func parse(n: int32) -> Result<String, String> {
  return n == 0 ? Err("zero") : Ok("fine");
}
if parse(3) is Ok(text) {
  print(text);
}
if parse(0) is Err(message) {
  print(message);
}
--- output
fine
zero

=== while with is
import std::option::{Option};
func find(n: int32) -> Option<int32> {
  return n > 2 ? None : Some(n * 10);
}
mut i = 0;
while find(i) is Some(x) {
  print(x);
  i = i + 1;
}
--- output
0
10
20

=== is in a ternary
import std::option::{Option};
let a: Option<int32> = Some(7);
print(a is Some(w) ? w : -1);
--- output
7

=== is binding isn't visible after ||
import std::option::{Option};
let a: Option<int32> = Some(7);
if a is Some(v) || v > 1 {
  print(1);
}
--- error
unknown identifier 'v'

=== is binding isn't visible in else
import std::option::{Option};
let a: Option<int32> = Some(7);
if a is Some(v) {
  print(1);
} else {
  print(v);
}
--- error
unknown identifier 'v'

=== patterns inside variant patterns
import std::option::{Option};
import std::result::{Result};
func find(n: int32) -> Option<Result<int32, String>> {
  if n == 0 {
    return None;
  }
  return n > 0 ? Ok(n) : Err("negative");
}
func describe(n: int32) -> String {
  return match find(n) {
    Some(Ok(1)) => "one",
    Some(Ok(_)) => "ok",
    Some(Err(e)) => e,
    None => "none",
  };
}
print(describe(1));
print(describe(5));
print(describe(-2));
print(describe(0));
if find(7) is Some(Ok(v)) {
  print(v);
}
--- output
one
ok
negative
none
7

=== a nested case missing is reported
import std::option::{Option};
import std::result::{Result};
let a: Option<Result<int32, String>> = None;
let s = match a {
  Some(Ok(1)) => "one",
  Some(Err(e)) => e,
  None => "none",
};
--- error
has to handle every case

=== tuple matches are complete over several values
enum Kind {
  A,
  B,
  C;
}
func f(x: (Kind, bool)) -> int32 {
  return match x {
    (Kind::A, _) => 1,
    (_, true) => 2,
    (Kind::B, false) => 3,
    (Kind::C, false) => 4,
  };
}
func g(x: (bool, int32)) -> int32 {
  return match x {
    (true, _) => 1,
    (false, 1) => 2,
    (false, _) => 3,
  };
}
print(f((Kind::A, false)));
print(f((Kind::C, true)));
print(f((Kind::B, false)));
print(f((Kind::C, false)));
print(g((false, 1)));
--- output
1
2
3
4
2

=== a missing tuple combination is reported
enum Kind {
  A,
  B,
  C;
}
func f(x: (Kind, bool)) -> int32 {
  return match x {
    (Kind::A, _) => 1,
    (_, true) => 2,
    (Kind::B, false) => 3,
  };
}
print(f((Kind::A, false)));
--- error
has to handle every case

=== a | pattern matches any of its alternatives
import std::option::{Option};
enum Op { Add, Sub, Mul, Lt, Eq; }
func kind(op: Op) -> String {
  match op {
    Op::Add | Op::Sub | Op::Mul => "arithmetic",
    Op::Lt | Op::Eq => "comparison",
  }
}
func small(n: int32) -> bool {
  match n {
    1 | 2 | 3 => true,
    _ => false,
  }
}
func word(s: String) -> int32 {
  match s {
    "a" | "b" => 1,
    _ => 2,
  }
}
func opt(o: Option<int32>) -> int32 {
  match o {
    Some(1 | 2) => 10,
    Some(_) => 20,
    None => 30,
  }
}
print(kind(Op::Sub));
print(kind(Op::Eq));
print(small(2));
print(small(7));
print(word("b"));
print(opt(Some(2)));
print(opt(Some(5)));
if Op::Mul is Op::Add | Op::Mul { print("is"); }
--- output
arithmetic
comparison
true
false
1
10
20
is

=== a | pattern counts every alternative for exhaustiveness
enum Op { Add, Sub, Mul; }
func k(op: Op) -> int32 {
  match op {
    Op::Add | Op::Sub => 1,
  }
}
print(k(Op::Add));
--- error
has to handle every case

=== a | pattern can't bind names
import std::option::{Option};
let o: Option<int32> = Some(1);
match o { Some(x) | None => print(1) }
--- error
can't bind names

=== an assignment can't be the value of a match arm
import std::option::{Option};
mut x = 0;
let o: Option<int32> = Some(1);
let y = match o {
  Some(v) => x = v,
  None => 0,
};
--- error
an assignment gives no value

=== a mut binding can be changed and changes the matched value
import std::option::{Option};
import std::vector::{Vector};
import std::result::{Result};
func errors() -> Result<int32, Vector<int32>> {
  mut v = Vector<int32>();
  v.push(1);
  v.push(2);
  return Err(v);
}
if errors() is Err(mut errs) {
  for e in errs.drain() { print(e); }
}
mut o: Option<int32> = Some(1);
match o {
  Some(mut n) => { n += 5; },
  None => print(0),
}
print(o is Some(6));
--- output
1
2
true

=== a mut binding needs a changeable value
import std::option::{Option};
let o: Option<int32> = Some(1);
match o { Some(mut n) => print(n), None => print(0) }
--- error
can't be `mut`, 'o' isn't
