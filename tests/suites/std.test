=== io::write prints without a newline
import std::io;
io::write("a");
io::write("b");
print("c");
--- output
abc

=== writing and reading files
import std::fs;
import std::string::{split};
match fs::write("note.txt", "first line\nsecond") {
  Result::Ok(count) => print(count),
  Result::Err(message) => print(message),
}
print(fs::exists("note.txt"));
print(fs::exists("other.txt"));
match fs::read("note.txt") {
  Result::Ok(text) => print(text.split('\n').get(1)),
  Result::Err(message) => print(message),
}
match fs::read("other.txt") {
  Result::Ok(content) => print(content),
  Result::Err(message) => print(message),
}
--- output
17
true
false
second
can't open the file 'other.txt'

=== reading a file bigger than one chunk
import std::fs;
mut line = "0123456789abcdef";
mut i = 0;
while i < 13 {
  line = line + line;
  i = i + 1;
}
match fs::write("big.txt", line + "end") {
  Result::Ok(count) => print(count),
  Result::Err(message) => print(message),
}
match fs::read("big.txt") {
  Result::Ok(text) => print(text.len()),
  Result::Err(message) => print(message),
}
--- output
131075
131075

=== reading through a reference to a path
import std::fs;
import std::path::{Path};
func load(path: &Path) -> String {
  match fs::read(path) {
    Ok(text) => return text,
    Err(error) => return error,
  }
}
match fs::write("note.txt", "hi") {
  Ok => print(load(Path("note.txt"))),
  Err(error) => print(error),
}
--- output
hi

=== creating directories
import std::fs;
import std::path::{Path};
match fs::create_dir(Path("made")) {
  Result::Ok => print("made"),
  Result::Err(error) => print(error),
}
match fs::create_dir(Path("made")) {
  Result::Ok => print("made twice"),
  Result::Err(error) => print(error),
}
match fs::create_dir_all(Path("deep/er/est")) {
  Result::Ok => print(fs::exists("deep/er/est")),
  Result::Err(error) => print(error),
}
match fs::create_dir(Path("missing/parent")) {
  Result::Ok => print("made"),
  Result::Err(error) => print(error),
}
--- output
made
can't create the directory 'made'
true
can't create the directory 'missing/parent'

=== writing into a missing directory is an error
import std::fs;
match fs::write("missing/note.txt", "x") {
  Result::Ok(count) => print(count),
  Result::Err(message) => print(message),
}
--- output
can't open the file 'missing/note.txt'

=== items imported by name
import std::fs::{write, read};
match write("a.txt", "hi") {
  Result::Ok(count) => print(count),
  Result::Err(message) => print(message),
}
match read("a.txt") {
  Result::Ok(text) => print(text),
  Result::Err(message) => print(message),
}
--- output
2
hi

=== a single imported item
import std::math::sqrt;
print(sqrt(25.0));
--- output
5.000000

=== an own function beats an imported one
import std::math::{sqrt};
func sqrt(x: float64) -> float64 {
  return x;
}
print(sqrt(25.0));
--- output
25.000000

=== math
import std::math;
print(math::pow(2.0, 10.0));
print(math::floor(math::pi() * 100.0));
print(math::abs(-3.5));
print(math::max(math::sin(0.0), math::cos(0.0)));
print(math::round(2.5));
--- output
