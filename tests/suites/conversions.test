=== int8 widens to int16
let a: int8 = -5;
let b: int16 = a;
print(b);
--- output
-5

=== int8 widens to int64
let a: int8 = -100;
let b: int64 = a;
print(b);
--- output
-100

=== int32 widens to int64
let a: int32 = -70000;
let b: int64 = a;
print(b);
--- output
-70000

=== uint8 widens to uint16
let a: uint8 = 255;
let b: uint16 = a;
print(b);
--- output
255

=== uint32 widens to uint64
let a: uint32 = 4000000000;
let b: uint64 = a;
print(b);
--- output
4000000000

=== uint8 widens to int16
let a: uint8 = 200;
let b: int16 = a;
print(b);
--- output
200

=== uint16 widens to int32
let a: uint16 = 65535;
let b: int32 = a;
print(b);
--- output
65535

=== uint32 widens to int64
let a: uint32 = 4000000000;
let b: int64 = a;
print(b);
--- output
4000000000

=== float32 widens to float64
let a: float32 = 1.5;
let b: float64 = a;
print(b);
--- output
1.500000

=== int16 converts to float32
let a: int16 = -300;
let b: float32 = a;
print(b);
--- output
-300.000000

=== uint8 converts to float32
let a: uint8 = 255;
let b: float32 = a;
print(b);
--- output
255.000000

=== int32 converts to float64
let a: int32 = -70000;
let b: float64 = a;
print(b);
--- output
-70000.000000

=== uint32 converts to float64
let a: uint32 = 4000000000;
let b: float64 = a;
print(b);
--- output
4000000000.000000

=== widening on function argument
func wide(x: int64) -> int64 {
  return x;
}
let a: int32 = 7;
print(wide(a));
--- output
7

=== int to float on function argument
func half(x: float64) -> float64 {
  return x / 2.0;
}
let a: int32 = 9;
print(half(a));
--- output
4.500000

=== widening on return
func get() -> int64 {
  let a: int16 = 1000;
  return a;
}
print(get());
--- output
1000

=== widening on assignment
mut big: int64 = 0;
let small: int8 = 42;
big = small;
print(big);
--- output
42

=== narrower side widens in binary expression
let a: int32 = 100;
let b: int64 = 5000000000;
print(a + b);
print(b + a);
--- output
5000000100
5000000100

=== uint8 plus int16
let a: uint8 = 200;
let b: int16 = 300;
print(a + b);
--- output
500

=== int plus float in binary expression
let a: int32 = 2;
let b: float64 = 0.5;
print(a + b);
--- output
2.500000

=== float32 plus float64
let a: float32 = 1.5;
let b: float64 = 2.25;
print(a + b);
--- output
3.750000

=== uint8 into sqrt
import std::math;
let a: uint8 = 196;
print(math::sqrt(a));
--- output
14.000000

=== int32 doesn't convert to float32
let a: int32 = 5;
let b: float32 = a;
--- error
type 'int32' does not match 'float32' in variable declaration

=== int64 doesn't convert to float64
let a: int64 = 5;
let b: float64 = a;
--- error
type 'int64' does not match 'float64' in variable declaration

=== int64 doesn't narrow to int32
let a: int64 = 5;
let b: int32 = a;
--- error
type 'int64' does not match 'int32' in variable declaration

=== int32 doesn't convert to uint32
let a: int32 = 5;
let b: uint32 = a;
--- error
type 'int32' does not match 'uint32' in variable declaration

=== int8 doesn't convert to uint64
let a: int8 = 5;
let b: uint64 = a;
--- error
type 'int8' does not match 'uint64' in variable declaration

=== uint32 doesn't convert to int32
let a: uint32 = 5;
let b: int32 = a;
--- error
type 'uint32' does not match 'int32' in variable declaration

=== float64 doesn't narrow to float32
let a: float64 = 5.0;
let b: float32 = a;
--- error
type 'float64' does not match 'float32' in variable declaration

=== float doesn't convert to int
let a: float32 = 5.0;
let b: int64 = a;
--- error
type 'float32' does not match 'int64' in variable declaration

=== int32 into float32 parameter is an error
func f(x: float32) {
  print(x);
}
let a: int32 = 5;
f(a);
--- error
type 'int32' does not match 'float32' in function argument

=== int32 plus uint32 has no common type
let a: int32 = 5;
let b: uint32 = 5;
print(a + b);
--- error
type 'int32' does not match 'uint32' in binary expression

=== int64 plus float64 has no common type
let a: int64 = 5;
let b: float64 = 5.0;
print(a + b);
--- error
type 'int64' does not match 'float64' in binary expression

=== refs don't convert
func f(x: &float64) {
  print(0);
}
let a: int32 = 5;
f(&a);
--- error
type 'Ref(int32)' does not match 'Ref(float64)' in function argument

=== value doesn't convert to a ref of another type
func f(x: &float64) {
  print(0);
}
let a: int32 = 5;
f(a);
--- error
type 'int32' does not match 'Ref(float64)' in function argument
