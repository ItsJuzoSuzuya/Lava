=== top level code of an imported module runs first
import a;
print("main");
--- file a.lv
print("module a");
--- output
module a
main

=== number types across modules
import conv;
let x: int32 = 7;
print(widen(x));
--- file conv.lv
pub func widen(x: int64) -> int64 {
  return x * 1000000000;
}
--- output
7000000000

=== error in an imported module shows its line
import broken;
print(1);
--- file broken.lv
pub func f() -> int32 {
  return "text";
}
--- error
return "text";

=== modules importing each other use each other's types and functions
import expression;
import statement;
mut outer = Expression(1);
mut inner = Expression(10);
inner.block.push(Statement(Expression(100)));
outer.block.push(Statement(inner));
outer.block.push(Statement(Expression(1000)));
print(sum_expression(&outer));
--- file expression.lv
import std::vector::{Vector};
import statement;
pub class Expression {
  pub value: int32 = value;
  pub block: Vector<Statement> = Vector<Statement>();

  Constructor(value: int32);
}
pub func sum_expression(expr: &Expression) -> int32 {
  mut total = expr.value;
  for stmt in expr.block {
    total = total + sum_statement(stmt);
  }
  return total;
}
--- file statement.lv
import expression;
pub class Statement {
  pub expr: Expression = expr;

  Constructor(expr: Expression);
}
pub func sum_statement(stmt: &Statement) -> int32 {
  return sum_expression(&stmt.expr);
}
--- output
1111

