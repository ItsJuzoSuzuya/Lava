=== import chain
import a;
print(from_a());
--- file a.lv
import b;
pub func from_a() -> int32 {
  return from_b() + 1;
}
--- file b.lv
pub func from_b() -> int32 {
  return 10;
}
--- output
11

=== shared import is loaded once
import a;
import b;
print(a_val());
print(b_val());
--- file a.lv
import shared;
pub func a_val() -> int32 {
  return base() + 1;
}
--- file b.lv
import shared;
pub func b_val() -> int32 {
  return base() + 2;
}
--- file shared.lv
pub func base() -> int32 {
  return 100;
}
--- output
101
102

=== missing module is an error
import nothing;
print(1);
