=== insert, remove and clear
import vector;

mut v = Vector<int32>();
print(v.is_empty());
v.push(1);
v.push(3);
v.insert(1, 2);
v.insert(0, 0);
v.insert(4, 4);
print(v.remove(2));
mut i: uint64 = 0;
while i < v.len() {
  print(v.get(i));
  i = i + 1;
}
v.clear();
print(v.is_empty());
--- file vector.lv
pub class Vector<T> {
  data: Buffer<T> = Buffer<T>(4);
  length: uint64 = 0;

  Constructor();

  pub func push(mut &self, item: T) {
    self.grow_if_full();
    self.data.set(self.length, item);
    self.length = self.length + 1;
  }

  pub func get(&self, index: uint64) -> T {
    self.check_index(index);
    return self.data.get(index);
  }

  pub func insert(mut &self, index: uint64, item: T) {
    if index > self.length {
      panic("insert index is out of bounds for the Vector");
    }
    self.grow_if_full();

    mut i = self.length;
    while i > index {
      self.data.set(i, self.data.get(i - 1));
      i = i - 1;
    }
    self.data.set(index, item);
    self.length = self.length + 1;
  }

  pub func remove(mut &self, index: uint64) -> T {
    self.check_index(index);
    let item = self.data.get(index);

    mut i = index;
    while i + 1 < self.length {
      self.data.set(i, self.data.get(i + 1));
      i = i + 1;
    }
    self.length = self.length - 1;
    return item;
  }

  pub func clear(mut &self) {
    self.length = 0;
  }

  pub func len(&self) -> uint64 {
    return self.length;
  }

  pub func is_empty(&self) -> bool {
    return self.length == 0;
  }

  func check_index(&self, index: uint64) {
    if index >= self.length {
      panic("index is out of bounds for the Vector");
    }
  }

  func grow_if_full(mut &self) {
    if self.length == self.data.capacity() {
      self.data.resize(self.data.capacity() * 2);
    }
  }
}
--- output
true
2
0
1
3
4
true

=== get past the length stops the program
class Vector<T> {
  data: Buffer<T> = Buffer<T>(4);
  length: uint64 = 0;

  Constructor();

  pub func push(mut &self, item: T) {
    self.data.set(self.length, item);
    self.length = self.length + 1;
  }

  pub func get(&self, index: uint64) -> T {
    if index >= self.length {
      panic("index is out of bounds for the Vector");
    }
    return self.data.get(index);
  }
}
mut v = Vector<int32>();
v.push(1);
print(v.get(0));
print(v.get(1));
print(2);
--- output
1
error: index is out of bounds for the Vector

=== push needs a mut binding
class Vector<T> {
  data: Buffer<T> = Buffer<T>(4);
  length: uint64 = 0;

  Constructor();

  pub func push(mut &self, item: T) {
    self.data.set(self.length, item);
    self.length = self.length + 1;
  }
}
let v = Vector<int32>();
v.push(1);
--- error
method 'push' changes 'self', so 'v' has to be mutable

=== at gives None past the end instead of stopping
import std::vector::{Vector};
mut v = Vector<String>();
v.push("first");
print(v.at(0) ?? "none");
print(v.at(5) ?? "none");
print(v.at(1).is_none());
--- output
first
none
true

=== indexing past the end stops the program
import std::vector::{Vector};
mut v = Vector<int32>();
v.push(1);
print(v[3]);
--- output
error: index 3 is out of bounds for a Vector of length 1

=== for loop over a vector
import std::vector::{Vector};
mut v = Vector<String>();
v.push("a");
v.push("b");
for x in v {
  for y in v {
    print(x + y);
  }
}
print(v.len());
--- output
aa
ab
ba
bb
2

=== for loop over the iter of a vector
import std::vector::{Vector};
mut v = Vector<int32>();
v.push(4);
v.push(5);
mut total = 0;
for x in v.iter() {
  total = total + x;
}
print(total);
--- output
9
