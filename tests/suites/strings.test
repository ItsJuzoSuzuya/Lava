private field

=== String can't be declared again
class String {
  x: int32 = 0;
  Constructor();
}
--- error
'String' is part of the language, it can't be declared again

=== slices share the bytes and stay usable
let text = "hello world";
let word = text.slice(6, 11);
let copy = word;
print(word);
print(copy.slice(1, 3));
print(word == "world");
print(text.byte(6) == word.byte(0));
print(word + "!");
print(word < "x");
--- output
world
or
true
true
world!
true

=== strip_prefix
import std::string::{strip_prefix};
let text = "hello world";
match text.strip_prefix("hello ") {
  Some(rest) => print(rest),
  None => print("no"),
}
print(text.strip_prefix("x").is_none());
--- output
world
true

=== a free function called on self in a method gets self
import std::string::{starts_with};
class Word {
  pub text: String;

  pub func starts_with_h(&self) -> bool {
    self.text.starts_with("h")
  }

  pub func longer(&self, than: uint64) -> bool {
    self.is_longer(than)
  }
}
func is_longer(word: &Word, than: uint64) -> bool {
  word.text.len() > than
}
let w = Word("hey");
print(w.starts_with_h());
print(w.longer(2));
--- output
true
true
