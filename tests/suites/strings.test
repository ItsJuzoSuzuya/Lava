=== numbers and bytes as strings
import std::string::{int_to_string, float_to_string, char_to_string};
print(int_to_string(-42) + "|" + float_to_string(2.5) + "|" + char_to_string('x'));
print(int_to_string(9223372036854775807));
--- output
-42|2.5|x
9223372036854775807

=== copy_bytes is hidden from programs
mut bytes = Buffer<uint8>(1);
copy_bytes(bytes, 0, bytes, 0, 1);
--- error
unknown function 'copy_bytes'

=== adding a char to a string
mut word = "ab";
word = word + 'c';
word += 'd';
print(word + "e"[0]);
--- output
abcde

=== a string from a Buffer of bytes
mut bytes = Buffer<uint8>(8);
bytes.set(0, 'h');
bytes.set(1, 'i');
let text = String(bytes, 2);
print(text);
print(text.len());
--- output
hi
2

=== a length beyond the Buffer stops the program
let text = String(Buffer<uint8>(2), 5);
print(text);
--- output
error: a String of 5 bytes doesn't fit into a Buffer of capacity 2

=== the operators are methods
let a = "abc";
print(a.concat("def"));
print(a.equals("abc"));
print(a.compare("abd") < 0);
print("b".compare("a") > 0);
--- output
abcdef
true
true
true

=== a string before a longer one starting with it
print("ab" < "abc");
print("abc" > "ab");
print("" < "a");
print("same" <= "same");
--- output
true
true
true
true

=== zero bytes are part of a string
let text = "a\0b";
print(text.len());
print(text[2] == 'b');
print(text == "a\0c");
--- output
3
true
false

=== strings through references and temporaries
import std::string::{int_to_string};
func twice(text: &String) -> String {
  return text + text;
}
func same(a: &String, b: &String) -> bool {
  return a == b && a <= b;
}
let word = "ab";
print(twice(&word));
print(twice("cd"));
print(same(&word, &word));
print("x" + int_to_string(1) + "y");
--- output
abab
cdcd
true
x1y

=== leaving a match on a temporary
enum Kind {
  Word => String,
  End;
}
class Token {
  pub kind: Kind = kind;
  Constructor(kind: Kind);
}
func make(text: String) -> Token {
  return Token(Kind::Word(text));
}
func word_of(text: String) -> String {
  match make(text).kind {
    Kind::Word(word) => return word,
    Kind::End => return "",
  }
}
mut i = 0;
while i < 3 {
  match make("w").kind {
    Kind::Word(w) => {
      if i == 1 {
        break;
      }
      print(w);
    }
    Kind::End => {}
  }
  i = i + 1;
}
print(word_of("hi"));
--- output
w
hi

