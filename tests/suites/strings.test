=== joining strings
let name = "Lava";
print("Hello, " + name + "!");
--- output
Hello, Lava!

=== comparing strings
print("abc" == "abc");
print("abc" != "abd");
print("abc" < "abd");
print("b" > "abc");
--- output
true
true
true
true

=== length, bytes and slices
let s = "hello";
print(s.len());
print(s.byte(0));
print(s.byte(4) == 'o');
print(s.slice(1, 4));
print(s.slice(5, 5) == "");
--- output
5
104
true
ell
true

=== byte out of bounds stops the program
let s = "hi";
print(s.byte(2));
--- output
error: index 2 is out of bounds for a String of length 2

=== slice out of bounds stops the program
let s = "hi";
print(s.slice(1, 3));
--- output
error: slice 1..3 is out of bounds for a String of length 2

=== numbers to strings
import std::string::{int_to_string, float_to_string, char_to_string};
print(int_to_string(-42) + "|" + float_to_string(0.5) + "|" + char_to_string('x'));
--- output
-42|0.5|x

=== std::string helpers
import std::string::{trim, starts_with, ends_with, contains, index_of};
let line = "  let x = 1;  ";
print(line.trim());
print(line.trim().starts_with("let"));
print(line.trim().ends_with(";"));
print(line.contains("x ="));
print(line.contains("y"));
print(index_of("abcabc", "ca").unwrap_or(99));
print(index_of("abc", "z").is_none());
--- output
let x = 1;
true
true
true
false
2
true

=== split and join
import std::string::{split, join};
let parts = "a,b,,c".split(',');
print(parts.len());
print(parts.join("-"));
--- output
4
a-b--c

=== parse_int
import std::string::{parse_int};
print(parse_int("123").unwrap_or(0));
print(parse_int("-7").unwrap_or(0));
print(parse_int("").is_none());
print(parse_int("-").is_none());
print(parse_int("4x").is_none());
--- output
123
-7
true
true
true

