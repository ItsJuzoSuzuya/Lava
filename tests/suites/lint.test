=== clean program has no warnings
func add(a: int32, b: int32) -> int32 {
  return a + b;
}
let x = add(1, 2);
print(x);
--- lint

=== unused variable
let x = 5;
print(1);
--- lint
main.lv:1:5 unused_variable: variable 'x' is never used

=== variable assigned but never read
mut x = 5;
x = 6;
--- lint
main.lv:1:5 unused_variable: variable 'x' is assigned but never read

=== underscore names are never unused
let _x = 5;
func f(_a: int32) {
  print(1);
}
f(1);
--- lint

=== unused parameter
func f(a: int32, b: int32) -> int32 {
  return a;
}
print(f(1, 2));
--- lint
main.lv:1:18 unused_parameter: parameter 'b' is never used

=== unused function
func helper() {
  print(1);
}
print(2);
--- lint
main.lv:1:6 unused_function: function 'helper' is never used

=== public functions may be unused
pub func helper() {
  print(1);
}
print(2);
--- lint

=== mut that is never changed
mut x = 1;
print(x);
--- lint
main.lv:1:5 unused_mut: 'x' is never changed, it can be declared with 'let'

=== mut that is changed through a field or method
class Counter {
  pub n: int32 = 0;

  Constructor();

  pub func bump(mut &self) {
    self.n = self.n + 1;
  }
}
mut a = Counter();
a.n = 2;
mut b = Counter();
b.bump();
print(a.n + b.n);
--- lint

=== mut self that doesn't change anything
class Counter {
  pub n: int32 = 0;

  Constructor();

  pub func get(mut &self) -> int32 {
    return self.n;
  }
}
mut c = Counter();
print(c.get());
--- lint
main.lv:6:21 unused_mut: 'get' doesn't change 'self', it can take '&self'

=== unused private method and field
class Point {
  pub x: int32 = 0;
  hidden: int32 = 0;

  Constructor();

  func secret(&self) -> int32 {
    return 1;
  }
}
let p = Point();
print(p.x);
--- lint
main.lv:3:3 unused_field: field 'hidden' is never read
main.lv:7:8 unused_method: method 'secret' is never used

=== trait methods may ignore their parameters
trait Scale {
  func scale(&self, factor: int32) -> int32;
}
impl Scale for int32 {
  func scale(&self, factor: int32) -> int32 {
    return 1;
  }
}
let x: int32 = 2;
print(x.scale(3));
--- lint

=== unused import
import helper;

print(1);
