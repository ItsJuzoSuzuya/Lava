pub func help() -> int32 {
  return 1;
}
--- lint

=== naming conventions
class my_point {
  pub someField: int32 = 0;

  Constructor();
}
enum color {
  dark_red => int32
}
func DoThing() {
  let BadName = 1;
  print(BadName);
}
DoThing();
let p = my_point();
print(p.someField);
let c = color::dark_red(1);
--- lint
main.lv:1:7 naming: 'my_point' should be PascalCase, like 'MyPoint'
main.lv:2:7 naming: 'someField' should be snake_case, like 'some_field'
main.lv:6:6 naming: 'color' should be PascalCase, like 'Color'
main.lv:7:3 naming: 'dark_red' should be PascalCase, like 'DarkRed'
main.lv:9:6 naming: 'DoThing' should be snake_case, like 'do_thing'
main.lv:10:7 naming: 'BadName' should be snake_case, like 'bad_name'
main.lv:16:5 unused_variable: variable 'c' is never used

=== unreachable code after return
func f() -> int32 {
  return 1;
  print(2);
}
print(f());
--- lint
main.lv:3:3 unreachable_code: this code never runs, it comes after a 'return'

=== constant conditions
if true {
  print(1);
}
if false {
  print(2);
} else {
  print(3);
}
while false {
  print(4);
}
--- lint
main.lv:1:4 constant_condition: the condition is always true, the 'if' isn't needed
main.lv:4:4 constant_condition: the condition is always false, the if branch never runs
main.lv:9:7 constant_condition: the condition is always false, the loop never runs

=== comparing and assigning a value to itself
mut x = 1;
if x == x {
  print(1);
}
x = x;
--- lint
main.lv:2:4 self_comparison: comparing a value with itself is always true
main.lv:5:1 self_assignment: assigning a value to itself does nothing

=== expression without effect
let x = 1;
x + 1;
--- lint
main.lv:2:1 no_effect: this expression does nothing, its value isn't used

=== comments are allowed
// a comment
let x = 1; // after code
print(x);
--- lint

=== generic vector has no false warnings
import vector;

mut v = Vector<int32>();
v.push(1);
print(v.get(0));
--- file vector.lv
pub class Vector<T> {
  data: Buffer<T> = Buffer<T>(4);
  length: uint64 = 0;

  Constructor();

  pub func push(mut &self, item: T) {
    self.grow_if_full();
    self.data.set(self.length, item);
    self.length = self.length + 1;
  }

  pub func get(&self, index: uint64) -> T {
    self.check_index(index);
    return self.data.get(index);
  }

  pub func clear(mut &self) {
    self.length = 0;
  }

  func check_index(&self, index: uint64) {
    if index >= self.length {
      panic("index is out of bounds for the Vector");
    }
  }

  func grow_if_full(mut &self) {
    if self.length == self.data.capacity() {
      self.data.resize(self.data.capacity() * 2);
    }
  }
}
--- lint

