=== same method in two traits is ambiguous
trait A {
  func name(&self) -> int32;
}
trait B {
  func name(&self) -> int32;
}
class Thing {
  v: int32 = v;

  Constructor(v: int32);
}
impl A for Thing {
  func name(&self) -> int32 {
    return 1;
  }
}
impl B for Thing {
  func name(&self) -> int32 {
    return 2;
  }
}
let t = Thing { v: 0 };
print(t.name());
--- error
method 'name' of 'Thing' is ambiguous

