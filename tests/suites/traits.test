=== implement a trait for uint8 with a literal in the body
trait Next {
  func next(&self) -> uint8;
}
impl Next for uint8 {
  func next(&self) -> uint8 {
    return self + 1;
  }
}
let x: uint8 = 254;
print(x.next());
--- output
