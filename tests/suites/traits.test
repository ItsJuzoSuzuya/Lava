=== implement a trait for an enum
enum Shape {
  Circle => int32,
  Square => int32
}
trait Area {
  func area(&self) -> int32;
}
impl Area for Shape {
  func area(&self) -> int32 {
    mut area = 0;
    match self {
      Shape::Circle(r) => area = r * r * 3,
      Shape::Square(s) => area = s * s,
    }
    return area;
  }
}
let c = Shape::Circle(2);
let s = Shape::Square(5);
print(c.area());
print(s.area());
--- output
12
25

=== enum method reads the tag through self
enum Light {
  Red => int32,
  Green => int32
}
trait Index {
  func index(&self) -> int32;
}
impl Index for Light {
  func index(&self) -> int32 {
    return self.tag;
  }
}
let l = Light::Green(0);
print(l.index());
--- output
1

