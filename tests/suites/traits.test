=== implement a trait for bool
trait Flip {
  func flip(&self) -> bool;
}
impl Flip for bool {
  func flip(&self) -> bool {
    mut flipped = false;
    match self {
      true => flipped = false,
      false => flipped = true,
    }
    return flipped;
  }
}
let b = true;
print(b.flip());
--- output
false

=== implement a trait for String
trait Shout {
  func shout(&self);
}
impl Shout for String {
  func shout(&self) {
    print(self);
  }
}
let s = "hello";
s.shout();
--- output
hello

=== built-in method with parameters
trait Plus {
  func plus(&self, other: int64) -> int64;
}
impl Plus for int64 {
  func plus(&self, other: int64) -> int64 {
    return self + other;
  }
}
let x: int64 = 5000000000;
print(x.plus(1));
