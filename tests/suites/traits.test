  func get(&self) -> int32;
}
class Box {
  v: int32 = v;

  Constructor(v: int32);
}
impl Get for Box {
  func get(&self) -> int32 {
    return 1;
  }
}
impl Get for Box {
  func get(&self) -> int32 {
    return 2;
  }
}
--- error
