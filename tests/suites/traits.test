=== implement a trait for a class
trait Shape {
  func area(&self) -> int32;
}
class Square {
  side: int32 = side;

  Constructor(side: int32);
}
impl Shape for Square {
  func area(&self) -> int32 {
    return self.side * self.side;
  }
}
let s = Square { side: 4 };
print(s.area());
--- output
16

=== two classes implement the same trait
trait Shape {
  func area(&self) -> int32;
}
class Square {
  side: int32 = side;

  Constructor(side: int32);
}
class Rect {
  w: int32 = w;
  h: int32 = h;

  Constructor(w: int32, h: int32);
}
impl Shape for Square {
  func area(&self) -> int32 {
    return self.side * self.side;
  }
}
impl Shape for Rect {
  func area(&self) -> int32 {
    return self.w * self.h;
  }
}
let s = Square { side: 3 };
let r = Rect { w: 2, h: 5 };
print(s.area());
print(r.area());
--- output
9
10

=== trait method with parameters
trait Scale {
  func scaled(&self, factor: int32) -> int32;
}
class Num {
  v: int32 = v;

  Constructor(v: int32);
}
impl Scale for Num {
  func scaled(&self, factor: int32) -> int32 {
    return self.v * factor;
  }
}
let n = Num { v: 7 };
print(n.scaled(3));
--- output
21

=== trait method without return value
trait Greet {
  func greet(&self);
}
class Person {
  name: String = name;

  Constructor(name: String);
}
impl Greet for Person {
  func greet(&self) {
    print(self.name);
  }
}
let p = Person { name: "Ada" };
p.greet();
--- output
Ada

=== default method is used when not implemented
trait Describe {
  func describe(&self) {
    print("something");
  }
}
class Box {
  v: int32 = v;

  Constructor(v: int32);
}
impl Describe for Box {
}
let b = Box { v: 1 };
b.describe();
--- output
something

=== default method can be overridden
trait Describe {
  func describe(&self) {
    print("something");
  }
}
class Box {
  v: int32 = v;

  Constructor(v: int32);
}
impl Describe for Box {
  func describe(&self) {
    print("a box");
  }
}
let b = Box { v: 1 };
b.describe();
--- output
a box

=== default method calls a required method
trait Shape {
  func area(&self) -> int32;

  func double_area(&self) -> int32 {
    return area() * 2;
  }
}
class Square {
  side: int32 = side;

  Constructor(side: int32);
}
impl Shape for Square {
  func area(&self) -> int32 {
    return self.side * self.side;
  }
}
let s = Square { side: 3 };
print(s.double_area());
--- output
18

=== default method uses fields through self
trait Show {
  func show(&self) {
    print(self.v);
  }
}
class Box {
  v: int32 = v;

  Constructor(v: int32);
}
impl Show for Box {
}
let b = Box { v: 42 };
b.show();
--- output
42

=== impl method calls a class method
trait Shape {
  func area(&self) -> int32;
}
class Square {
  side: int32 = side;

  Constructor(side: int32);

  func get_side(&self) -> int32 {
    return self.side;
  }
}
impl Shape for Square {
  func area(&self) -> int32 {
    return get_side() * get_side();
  }
}
let s = Square { side: 5 };
print(s.area());
--- output
25

=== class implements two traits
trait A {
  func a(&self) -> int32;
}
trait B {
  func b(&self) -> int32;
}
class Thing {
  v: int32 = v;

  Constructor(v: int32);
}
impl A for Thing {
  func a(&self) -> int32 {
    return self.v + 1;
  }
}
impl B for Thing {
  func b(&self) -> int32 {
    return self.v + 2;
  }
}
let t = Thing { v: 10 };
print(t.a());
print(t.b());
--- output
11
12

=== class method wins over trait method with the same name
trait Name {
  func name(&self) -> int32;
}
class Thing {
  v: int32 = v;

  Constructor(v: int32);

  pub func name(&self) -> int32 {
    return 1;
  }
}
impl Name for Thing {
  func name(&self) -> int32 {
    return 2;
  }
}
let t = Thing { v: 0 };
print(t.name());
--- output
1

=== trait declared after the impl
class Box {
  v: int32 = v;

  Constructor(v: int32);
}
impl Get for Box {
  func get(&self) -> int32 {
    return self.v;
  }
}
trait Get {
  func get(&self) -> int32;
}
let b = Box { v: 3 };
print(b.get());
--- output
3

=== trait from another module
import shapes;
class Square {
  side: int32 = side;

  Constructor(side: int32);
}
impl Shape for Square {
  func area(&self) -> int32 {
    return self.side * self.side;
  }
}
let s = Square { side: 6 };
print(s.area());
--- file shapes.lv
pub trait Shape {
  func area(&self) -> int32;
}
--- output
36

=== literal adapts to trait method parameter
trait Scale {
  func scaled(&self, factor: int64) -> int64;
}
class Num {
  v: int32 = v;

  Constructor(v: int32);
}
impl Scale for Num {
  func scaled(&self, factor: int64) -> int64 {
    return factor * 2;
  }
}
let n = Num { v: 1 };
print(n.scaled(3000000000));
--- output
6000000000

