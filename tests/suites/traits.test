=== same trait for a class and a built-in type
trait Size {
  func size(&self) -> int32;
}
class Box {
  v: int32 = v;

  Constructor(v: int32);
}
impl Size for Box {
  func size(&self) -> int32 {
    return self.v;
  }
}
impl Size for int32 {
  func size(&self) -> int32 {
    return 4;
  }
}
let b = Box { v: 10 };
let x: int32 = 0;
print(b.size());
print(x.size());
--- output
10
4

=== different int types have separate impls
trait Name {
  func name(&self);
}
impl Name for int32 {
  func name(&self) {
    print("int32");
  }
}
impl Name for int64 {
  func name(&self) {
    print("int64");
  }
}
let a: int32 = 1;
let b: int64 = 1;
a.name();
b.name();
--- output
int32
int64

