=== create an enum value and match it
enum Shape {
  Circle => int32,
  Square => int32
}
let s = Shape::Circle(5);
match s {
  Shape::Circle(r) => print(r),
  Shape::Square(a) => print(a),
}
--- output
5

=== second variant matches
enum Shape {
  Circle => int32,
  Square => int32
}
let s = Shape::Square(7);
match s {
  Shape::Circle(r) => print(r),
  Shape::Square(a) => print(a),
}
--- output
7

=== variants with different payload types
enum Value {
  Number => int32,
  Text => String
}
let a = Value::Number(42);
let b = Value::Text("hi");
match a {
  Value::Number(n) => print(n),
  Value::Text(t) => print(t),
}
match b {
  Value::Number(n) => print(n),
  Value::Text(t) => print(t),
}
--- output
42
hi

=== match arm without binding
enum Light {
  Red => int32,
  Green => int32
}
let l = Light::Green(0);
match l {
  Light::Red => print("stop"),
  Light::Green => print("go"),
}
--- output
go

=== wildcard arm
enum Light {
  Red => int32,
  Yellow => int32,
  Green => int32
}
let l = Light::Yellow(0);
match l {
  Light::Red => print("stop"),
  _ => print("other"),
}
--- output
other

=== block arm body
enum Num {
  Int => int32,
  Big => int64
}
let n = Num::Int(4);
match n {
  Num::Int(v) => {
    let doubled = v * 2;
    print(doubled);
  }
  Num::Big(v) => print(v),
}
--- output
8

=== payload used in arithmetic
enum Num {
  Int => int32,
  Big => int64
}
let n = Num::Int(20);
match n {
  Num::Int(v) => print(v + 1),
  Num::Big(v) => print(v),
}
--- output
21

=== print an enum value prints its payload
enum Value {
  Number => int32,
  Text => String
}
let a = Value::Number(42);
print(a);
--- output
42

=== print a string payload
enum Value {
  Number => int32,
  Text => String
}
let b = Value::Text("hello");
print(b);
--- output
hello

=== tag of a variant
enum Light {
  Red => int32,
  Yellow => int32,
  Green => int32
}
let l = Light::Green(0);
print(l.tag);
--- output
2

=== literal adapts to the payload type
enum Num {
  Small => uint8,
  Big => int64
}
let a = Num::Small(200);
let b = Num::Big(5000000000);
match b {
  Num::Small(v) => print(v),
  Num::Big(v) => print(v),
}
--- output
5000000000

=== payload literal out of range
enum Num {
  Small => uint8,
  Big => int64
}
let a = Num::Small(300);
--- error
literal '300' doesn't fit into 'uint8'

=== class payload with brace init
class Point {
  pub x: int32 = x;
  pub y: int32 = y;

  Constructor(x: int32, y: int32);
}
enum Shape {
  Dot => Point,
  Size => int32
}
let s = Shape::Dot { x: 3, y: 4 };
match s {
  Shape::Dot(p) => print(p.x + p.y),
  Shape::Size(n) => print(n),
}
--- output
7

=== wrong payload type
enum Value {
  Number => int32,
  Text => String
}
let a = Value::Number("no");
--- error
type 'String' does not match 'int32' in enum variant payload

=== unknown variant
enum Value {
  Number => int32,
  Text => String
}
let a = Value::Other(1);
--- error
enum 'Value' has no variant 'Other'

=== unknown enum
let a = Nope::Thing(1);
--- error
unknown enum 'Nope'

=== match pattern of another enum
enum A {
  X => int32
}
enum B {
  Y => int32
}
let a = A::X(1);
match a {
  B::Y(v) => print(v),
}
--- error
match arm pattern

=== unknown enum method is an error
enum Value {
  Number => int32
}
let a = Value::Number(1);
a.go();
--- error
unknown function 'go'

=== enum passed to a function
enum Value {
  Number => int32,
  Text => String
}
func show(v: Value) {
  match v {
    Value::Number(n) => print(n),
    Value::Text(t) => print(t),
  }
}
show(Value::Text("passed"));
--- output
passed

=== enum methods
enum Shape {
  Circle => int32,
  Square => int32;

  pub func area(&self) -> int32 {
    match self {
      Shape::Circle(r) => return 3 * r * r,
      Shape::Square(side) => return side * side,
    }
  }

  pub func name(&self) -> String {
    match self {
      Shape::Circle => return "circle",
      Shape::Square => return "square",
    }
  }
}
let c = Shape::Circle(2);
print(c.area());
print(Shape::Square(3).area());
print(c.name());
--- output
12
9
circle

=== enum method calls another one without receiver
enum Light {
  Red,
  Green;

  pub func can_go(&self) -> bool {
    return !self.is_red();
  }

  func is_red(&self) -> bool {
    match self {
      Light::Red => return true,
      _ => return false,
    }
  }
}
print(Light::Green.can_go());
print(Light::Red.can_go());
--- output
true
false

=== enum method changing self
enum Light {
  Red,
  Green;

  pub func switch(mut &self) {
    match self {
      Light::Red => self = Light::Green,
      Light::Green => self = Light::Red,
    }
  }
}
mut light = Light::Red;
light.switch();
print(light);
--- output
Green

=== methods of a generic enum
enum Pair<T> {
  Both => T,
  Neither;

  pub func or(&self, other: T) -> T {
    match self {
      Pair::Both(value) => return value.clone(),
      Pair::Neither => return other,
    }
  }
}
let a = Pair::Both(5);
let b: Pair<String> = Pair::Neither;
print(a.or(1));
print(b.or("none"));
--- output
5
none

=== private enum method is an error outside
enum Light {
  Red;

  func secret(&self) -> int32 {
    return 1;
  }
}
print(Light::Red.secret());
--- error
Tried calling a private function 'secret'

=== variants after methods are an error
enum Light {
  Red;

  func f(&self) {
    print(1);
  }

  Green
}
--- error
variants come before the methods

=== option and result methods
import std::option::{Option};
import std::result::{Result};
let some = Option::Some(1);
let ok: Result<int32, String> = Result::Ok(2);
print(some.is_some());
print(some.is_none());
print(ok.is_ok());
print(ok.ok_or(0));
--- output
true
false
true
2
